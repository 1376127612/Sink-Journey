// kubejsstudio custom: kubejsstudio:flint_pickaxe
ServerEvents.generateData('after_mods', event => {
    event.json(
      'kubejsstudio:recipe/flint_pickaxe',
      {
        "type": "oraculumworktables:mason_shaped",
        "result": { "item": "notreepunchingremastered:flint_pickaxe" },
        
        // 修改点：tools 必须用对象数组，写明具体工具 ID 和耐久消耗
        "tools": [
          { "item": "minecraft:stone_pickaxe", "damage": 1 }
        ],
        
        "pattern": [
          "AA",
          "AA"
        ],
        "key": {
          "A": { "item": "minecraft:stone" }
        }
      }
    )
})
