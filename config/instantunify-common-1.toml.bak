#How the two lists above are combined
#Allowed Values: USE_WHITELIST, USE_BLACKLIST, USE_BOTH_LISTS, USE_NO_LIST
listMode = "USE_BOTH_LISTS"
#Preferred Mods: the first mod in this list that provides a material wins
preferredMods = [
	"minecraft",
	"kubejs",
	"create",
	"mekanism",
	"ae2",
	"mekmm",
	"embers",
	"ad_astra",
	"enderio",
	"enderio_evolution",
	"industrialupgrade",
	"nuclearcraftneohaul",
	"neoecoae",
	"appflux",
	"extendedae",
	"ae2cs",
	"ae2lt",
	"pneumaticcraft",
	"roots",
	"projectred_core",
]
#Blacklisted Mods: their items are never replaced and never used as a target
blacklistMods = [
	"chisel",
	"astralsorcery"
]
#Exempt Mods: their items are never replaced, but other mods' items may still turn into them
#Use this for a mod that owns a material and should stay the way it is (AE2 silicon)
exemptMods = [
	"ae2"
]
#Blacklisted Items: these item ids are never replaced (empty by default)
blacklistItems = [
	"nuclearcraftneohaul:fertile_isotope_americium_block",
	"nuclearcraftneohaul:fertile_isotope_berkelium_block",
	"nuclearcraftneohaul:fertile_isotope_californium_block",
	"nuclearcraftneohaul:fertile_isotope_curium_block",
	"nuclearcraftneohaul:fertile_isotope_neptunium_block",
	"nuclearcraftneohaul:fertile_isotope_plutonium_block",
	"nuclearcraftneohaul:fertile_isotope_uranium_block",
]
#Namespaces that mean the same thing, the first entry of a group is the canonical one
#Keeps items that only ship one of the two spellings (forge: and c:) in the same group
namespaceAliases = [
	["forge", "c"]
]
#Never unify two items of the same mod with each other
#On by default: mods ship variants that only make sense next to each other
sameModNoUnify = true

["Unify event"]
	#Unify when items drop
	drop = true
	#Unify drops when entities die
	death = true
	#Unify every second items in player's inventory
	second = false
	#Unify items in player's inventory when they change
	change = true
	#Unify items when a container is opened (writes into containers)
	gui = false
	#Unify loot table output (block drops, mob drops, chests, fishing)
	harvest = false

[performance]
	#Cache the material index (tag fingerprint -> dominant item) instead of scanning the item registry on every drop
	#Turning this off restores the slow behaviour, useful for troubleshooting
	indexCache = true
	#Rebuild the material index automatically after this many seconds, 0 = rebuild only on tag/config changes
	# Default: 0
	# Range: 0 ~ 86400
	lazyIndexRefreshSeconds = 0
