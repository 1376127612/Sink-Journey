// kubejsstudio custom: kubejsstudio:flint_pinkaxe2
ServerEvents.recipes(event => {
    event.recipes.oraculumworktables.mason_shaped(
      'notreepunchingremastered:flint_pickaxe', // 1. result：产物
      ['AA', 'AA'],                             // 2. pattern：字符串图案
      { A: 'minecraft:stone' }                 // 3. key：符号与材料的映射
    )
    // 4. 工具配置（使用 .tools 传入对象数组）
    .tools([{ item: 'minecraft:stone_axe', damage: 10 }]);
})
// kubejsstudio custom: kubejsstudio:flint_pickaxe2
ServerEvents.generateData('after_mods', event => {
    event.json(
      'kubejsstudio:recipe/flint_pickaxe2',
      {
        "type": "oraculumworktables:mason_shaped",
        "result": { "item": "notreepunchingremastered:flint_pickaxe", "count": 1 },
        "pattern": [
            'ASA',
            'SSA',
            'SSS'
        ],
        "key": {
          "A": {"item": "minecraft:stone"},
          "S":{"item":"minecraft:dirt"}
        },
        "tools": [
          { "item": "minecraft:stone_axe", "damage": 10 }
        ],
      }
      .secondaryIngredients([
          { "item": "minecraft:cobblestone" },
          { "item": "minecraft:cobblestone" },
          { "item": "minecraft:cobblestone" }
        ])
        
       .consumeSecondaryIngredients(true)
    )
})
