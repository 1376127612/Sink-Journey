	chapter.6CD44026301F6F75.title: "触及星辰"
	chapter.6E59CB6F7D053B92.title: "前情提要"
	chapter.7C4E2F5CB393C0AE.title: "深入原子"
	chapter_group.110ED09B617A1F32.title: "初来乍到"
	chapter_group.1D6589548F232270.title: "科技革命"
	chapter_group.672ED601CC36FA35.title: "扉页"
	chapter_group.705D4C8363D05D0F.title: "工业起步"
	quest.0056045684755D67.quest_desc: [
		"在基座上放置元素象征，在上方放置对应物品。将光束炮对准炼金台，并通入红石信号，光束炮会向炼金台开炮，启动炼金仪式。"
		""
		"我想你可能需要多准备几份材料。"
		"{@pagebreak}"
		"炼金失败后的产物，会显示不同的光点。亮色光点代表有一个基座中上面的材料与下方的象征匹配成功且符合配方，淡色光点代表有一个基座下方的象征是配方所需，但上方的材料与它不匹配。"
		"如果我是你的话，我会尽早制作一份解码石板。"
		"但如果你问我解码石板也要炼金制作怎么办，那我的回答是，只有天知道。"
	]
	quest.0056045684755D67.quest_subtitle: "这很魔法，对吧"
	quest.018AA31ED4D322D9.quest_desc: [
		"印刷硅片配红石、金锭、钻石各压一次：逻辑、运算、工程处理器。"
		"逻辑管合成，运算管存储，工程管机械，三个合起来才是 AE 的脑子。"
	]
	quest.018AA31ED4D322D9.quest_subtitle: "处理器"
	quest.018AA31ED4D322D9.title: "三个脑子"
	quest.03232381B779A520.quest_desc: ["奇怪，下界森林中居然还有这种硕大蘑菇，难道下界生物有着自己获取能量的方式吗？"]
	quest.03B4867738AD7EBF.quest_desc: ["八块钢板围一个红石块，再配四根原木。工业先锋的每一台机器都要先有它。"]
	quest.03B4867738AD7EBF.quest_subtitle: "工业先锋的入场券"
	quest.03B4867738AD7EBF.title: "简陋机器框架"
	quest.03CF66A8B862AB79.quest_desc: ["经过你的猎杀研究，这种生活在深渊一层倒悬之树上的生物的鳞片具有很好的减震效果。如果把它制作成一种盔甲会怎么样呢？"]
	quest.040AC4A0F65176E3.quest_desc: [
		"§a热气动加工机§f只做一件事：把一种流体变成另一种流体。加热、加压、冷却都在它肚子里完成。"
		"塑料从这里来——100 mB §a液化石油气§f加一块煤，100℃ 下变成 1000 mB 熔融塑料。柴油 → 煤油 → 汽油 → 液化石油气 的整条裂解链也走这台。"
	]
	quest.040AC4A0F65176E3.quest_subtitle: "一种流体进，另一种出来"
	quest.040AC4A0F65176E3.title: "热气动加工机"
	quest.04775118903D8E3F.quest_desc: [
		"把物品浸泡在储罐里的液体中：金板做内衬，铜板做衬底，琥珀金锅炉供热。"
		"需要吸收溶液或试剂的固体毛坯都要过它一手。到这里，原始时代的手工机器就齐了——下一站是青铜。"
	]
	quest.04775118903D8E3F.quest_subtitle: "把东西泡进去"
	quest.04775118903D8E3F.title: "原型流式腐蚀釜"
	quest.055588A7FFB2D789.quest_desc: ["把铁锭塞进挤压原型机，压出八块铁板。后面每一台原型机都要吃它。"]
	quest.055588A7FFB2D789.quest_subtitle: "八块，起步价"
	quest.055588A7FFB2D789.title: "铁板"
	quest.058676663FEB137F.quest_desc: ["制作扩展构件，你可以用它来扩展嵌套工厂的空间"]
	quest.058676663FEB137F.quest_subtitle: "空间"
	quest.05C904B7B3FB589E.quest_desc: ["我还以为你会喜欢这个。"]
	quest.05C904B7B3FB589E.quest_subtitle: "美丽的建材"
	quest.0688CF0589EE3128.quest_desc: ["你不这么认为吗？"]
	quest.0688CF0589EE3128.quest_subtitle: "这是一种很漂亮的建材"
	quest.0706F92EF2C236B8.quest_desc: ["八张蒸汽机壳夹一颗黄铜之心，就是蒸汽机机身。本时代所有机器都长在它上面。"]
	quest.0706F92EF2C236B8.quest_subtitle: "机身、蒸汽与压力"
	quest.0706F92EF2C236B8.title: "蒸汽时代"
	quest.079D6EAF9A441826.quest_desc: [
		"挤压部件、铁锭外壳、木板机架。它没有界面也没有电：右键投料，等它压，右键取件。"
		"铁砧在这一版里被封掉了——锭变板不再是锤子的事，而是这台机器的事。"
	]
	quest.079D6EAF9A441826.quest_subtitle: "第一台不用右手帮忙的机器"
	quest.079D6EAF9A441826.title: "挤压原型机"
	quest.09200AF098A644DF.quest_desc: ["现在，来制作你的第一块合金吧。"]
	quest.09200AF098A644DF.quest_subtitle: "一种新奇的合金炉"
	quest.0932DD0AA54FD551.quest_subtitle: "或许你要自己组装？"
	quest.0932DD0AA54FD551.title: "做一把斧头有哪些步骤"
	quest.0A449D27D8734333.quest_desc: ["长按右键启动，胶囊负责把抽上来的液体装走。它覆盖下方 3×1×3 的范围。"]
	quest.0A449D27D8734333.quest_subtitle: "液体必须待在它下方"
	quest.0A449D27D8734333.title: "原型泵"
	quest.0AFA7391D17E0228.quest_desc: [
		"//......我在四处张望着，这里似乎都是倒悬生长的树木，深渊之眼坠落之处有着不同方向连接而来的枝蔓将我接住了，幸好我还活着。"
		"//.....这里有许多生物活动的迹象，或许我应该尝试捕捉一些来了解这些生物。"
		"//.....深渊似乎并不都是死物，这里的植物也生长的茂密，不知道再深入时候也是如此。"
	]
	quest.0B73D9E1303C41BD.quest_desc: ["如果我是你的话，我会尽快制作这台机器并完成它的自动化。"]
	quest.0B73D9E1303C41BD.quest_subtitle: "好像是没有什么用的机器"
	quest.0BDB4E32ADB4A504.quest_desc: [
		"钢锭裹着合金拉出来的线，一根过 5 kFE/t。"
		"超了会热上来、烧断：看一眼机器台账，别把压缩机和分离机挂在同一根上。"
	]
	quest.0BDB4E32ADB4A504.quest_subtitle: "通用线缆"
	quest.0BDB4E32ADB4A504.title: "先把电送到该去的地方"
	quest.0C29A1DD13981ECC.quest_desc: [
		"结晶器里，1000 mB §a硅烷§f在 800℃ 热分解，沉积出一块§a11N 多晶硅§f。碳氧与金属杂质再降一档。"
		"只有它熔出来的硅能进器件线，所以 qmd 的晶柱也被压在它后面。"
	]
	quest.0C29A1DD13981ECC.quest_subtitle: "800℃ 裂一遍"
	quest.0C29A1DD13981ECC.title: "11N 多晶硅"
	quest.0C41A7B3D9E256F1.quest_desc: [
		"石脑油 8000 + 氢 240 → 精制石脑油 7850 + 硫化氢 100。酸质原油：耗氢 480，硫化氢 220。"
		"这一条挂在通用反应器的气固固定床池里：北墙气压接口 ≥2 bar，催化剂槽放钢块（硅铝床）。"
		"现实是 Co-Mo/Al2O3 固定床、300~350℃、2~4 MPa，硫以硫化氢摘掉。"
	]
	quest.0C41A7B3D9E256F1.quest_subtitle: "石脑油脱硫"
	quest.0C41A7B3D9E256F1.title: "石脑油加氢精制（固定床）"
	quest.0C41A7B3D9E256F2.quest_desc: [
		"精制石脑油 8000 + 过热蒸汽 4000 → 乙烯 1920、丙烯 1120、丁烯 720、裂解汽油 1600、甲烷 2400；副产石油焦。"
		"同一台通用反应器切到管式裂解池，炉管槽放对应合金块：钢 1920 → 钼钢 2240 → 因科镍 2560 → 钛 2880（乙烯产量）。"
		"现实里裂解炉与蒸汽转化炉是同一类设备：外热列管，靠炉管材质定裂解深度与结焦。气压 ≥2 bar。"
		"石油焦占物品输出位，堆满后停机。"
	]
	quest.0C41A7B3D9E256F2.quest_subtitle: "石脑油裂解"
	quest.0C41A7B3D9E256F2.title: "石脑油蒸汽裂解（管式炉）"
	quest.0C41A7B3D9E256F8.quest_desc: [
		"乙烯 400 → 聚乙烯 200；丙烯 400 → 聚丙烯 200。"
		"聚合与固化都在化学反应釜里跑：IU 的高分子聚合器、液体固化反应釜已经整池封禁，"
		"化学只认这台釜。蒸汽档 3×3×4，钢壳 + 蒸汽仓。"
	]
	quest.0C41A7B3D9E256F8.quest_subtitle: "乙烯/丙烯聚合"
	quest.0C41A7B3D9E256F8.title: "化学反应釜（蒸汽）"
	quest.0C41A7B3D9E256F9.quest_desc: [
		"聚合物液体 250 mB + 氧 100 → 固体 1。"
		"聚乙烯、聚丙烯各走一次。这条反应的产物是物品，所以釜的 y2 西墙要挂一个物品输出总线；"
		"固体产物送化工厂。"
	]
	quest.0C41A7B3D9E256F9.quest_subtitle: "固体出料口"
	quest.0C41A7B3D9E256F9.title: "物品输出总线"
	quest.0C41A7B3D9E256FA.quest_desc: [
		"聚乙烯 1 + 聚丙烯 1 + 水 1000 → 塑料 1。"
		"塑料进塑型机出塑料板。"
		"后续装置：中期 常压蒸馏塔 / 减压蒸馏塔 / 催化裂化 / 催化重整 / 加氢精制 / 硫回收；后期 加氢裂化 / 延迟焦化 / 丁烯叠合 / 润滑油 / 沥青。"
	]
	quest.0C41A7B3D9E256FA.quest_subtitle: "电力时代的关键材料"
	quest.0C41A7B3D9E256FA.title: "塑料"
	quest.0C41A7B3D9E25710.quest_desc: [
		"一台机器三个工艺池：气固固定床跑蒸汽重整、一氧化碳变换、SO2 氧化、氨氧化；"
		"流化床跑沸腾氯化与冷氢化；高压合成跑甲醇与氨合成。控制器界面里选池，"
		"换催化剂槽里的合金块就是换工艺，不用再造一台机器。"
		"气压门槛走气动接口：氯化 3 bar，甲醇与氨合成 20 bar（压缩机顶格）。"
	]
	quest.0C41A7B3D9E25710.quest_subtitle: "一台机器三种反应器"
	quest.0C41A7B3D9E25710.title: "通用反应器"
	quest.0C41A7B3D9E25711.quest_desc: [
		"气体从塔底进、液体从塔顶进，塔底出釜液、塔顶出尾气。"
		"气液吸收池跑 SO3 吸收、硝酸吸收、HCl 吸收；反应精馏池跑三氯硅烷歧化。"
		"塔板槽定吸收段精度（钢 → 不锈钢 → 因科镍 → 钛），树脂槽只对精馏生效。"
		"塔器是反应器的另一条腿：吸收与精馏都在塔里跑，大型塔器再把它放大。两条腿都不必经，主线走到塑料就够。"
	]
	quest.0C41A7B3D9E25711.quest_subtitle: "吸收塔与催化精馏塔"
	quest.0C41A7B3D9E25711.title: "通用塔器"
	quest.0C41A7B3D9E25712.quest_desc: [
		"放大版分三档：不锈钢 5×5×7（并行 8）→ 钛 5×5×8（10）→ 钴铬 5×5×9（12），仓跟着换（改良 / 高级 / 完美）。"
		"四个工艺池与标准机型共用，端口按大宗与多股工艺放宽：4 路流体进、5 路流体出、2 个物品口——"
		"裂解的五股馏分各占一口，不用在外面临时拆分管路。内件三槽规则不变（催化剂 / 耐压 / 炉管）。"
	]
	quest.0C41A7B3D9E25712.quest_subtitle: "放大，而不是再造一条"
	quest.0C41A7B3D9E25712.title: "大型通用反应器"
	quest.0C41A7B3D9E25713.quest_desc: [
		"同样三档：因科镍 5×5×9（并行 3）→ 钛 5×5×10（4）→ 钴铬 5×5×11（6），仓随档换。"
		"两个塔板槽分上下两段，一段吸收一段精馏可以在同一台塔里接起来；气体与液体各留两路进料，"
		"塔底三路出料（釜液、循环液、侧线）。两个塔板槽放同一等级，免得等级判定挑错槽。"
	]
	quest.0C41A7B3D9E25713.quest_subtitle: "双段塔板"
	quest.0C41A7B3D9E25713.title: "大型塔器"
	quest.0C5D79478D494E93.quest_desc: ["从物品里榨出液体：橡胶、树脂、植物油。副产物是它最可爱的地方。"]
	quest.0C5D79478D494E93.quest_subtitle: "榨干最后一点"
	quest.0C5D79478D494E93.title: "蒸汽提取机"
	quest.0C64C102F22F0A8D.quest_desc: [
		"2 块§a11N 多晶硅§f + 2000 mB §a液氦§f + 1 个§a铌钛线圈§f，磁控直拉炉 90 秒、512 FE/t，拉出一根§a器件级单晶硅棒§f。"
		"这一档不提纯，提的是晶体质量：磁场压住熔体对流，氧含量和径向电阻率才够均匀。"
		"必须从多晶硅重新长。控氧控偏析只发生在熔体里，拿 11N 单晶洗一遍不算升级。"
	]
	quest.0C64C102F22F0A8D.quest_subtitle: "磁场压住对流"
	quest.0C64C102F22F0A8D.title: "磁控直拉：器件级晶棒"
	quest.0C743B1D27F300AB.quest_desc: ["多么奇怪的植物，明明从腐烂之物中生长出来的植物，却有如月光般的色彩。"]
	quest.0CD5982948BFD360.quest_desc: [
		"§a压力计§f是手持的：拿着它对准任意一台气动机器右键，它的参数、这一段的压力、管子的朝向，全读给你看。"
		"装了 WAILA 或者探针类模组的话它用处不大。可一旦开始漏气，还是它最快。"
	]
	quest.0CD5982948BFD360.quest_subtitle: "拿在手里，右键读一遍"
	quest.0CD5982948BFD360.title: "压力计"
	quest.0DAEFCCE3BFBEF69.quest_desc: ["穿戴完整的套装可以获得免受灼伤的能力。"]
	quest.0E2A114F298F8ACD.quest_desc: [
		"将海蓝宝石放入聚星缸，它会产出星能液，收集你的星能液，在后面会消耗很多"
		"你还可以用共振宝石，水晶石/共鸣水晶石，天辉水晶石/共鸣天辉水晶石来获取星能液"
	]
	quest.0E2A114F298F8ACD.quest_subtitle: "收集星能"
	quest.0F63E5FD6083EF59.title: "不要动"
	quest.0FBCC897FDF2C9DC.quest_desc: ["我从未如此想念过你，亲爱的精密加热仪器。"]
	quest.0FBCC897FDF2C9DC.quest_subtitle: "精密加热铸型仪器"
	quest.0FEC076007556020.quest_desc: ["输入普通蒸汽，输出过热蒸汽。压力调节器只吃过热蒸汽，所以它是整条压力线的上游。"]
	quest.0FEC076007556020.quest_subtitle: "把蒸汽烧得更烫"
	quest.0FEC076007556020.title: "蒸汽流体加热器"
	quest.1057DBBF8DC8C7C0.quest_desc: [
		"我们认为一个原始人能够徒手砍伐树木过于超模了，于是对steve的双手进行了一定的限制，现在你无法通过双手来砍伐树木了。"
		""
		"如果你现在试图对着一棵树长按左键，我会假装没看见。但树会记住的。"
	]
	quest.1057DBBF8DC8C7C0.quest_subtitle: "你连树都撸不了"
	quest.1057DBBF8DC8C7C0.title: "开始游戏"
	quest.113D916789ACE093.quest_desc: [
		"§a精炼厂控制器§f上竖直堆输出端，堆几个就切几段：2 个 100℃ 出柴油和渣油，3 个 150℃ 多出石脑油，4 个 200℃ 才拿得到液化石油气。"
		"热量越多跑得越快，但能不能切出某一段只看温度门槛。石脑油现在没人吃，这是故意的——它要等电。"
		"提示：控制器一个就够，§a精炼厂输出端§f往上摞，别摆成一排。"
	]
	quest.113D916789ACE093.quest_subtitle: "2/3/4 个输出端，100/150/200℃"
	quest.113D916789ACE093.title: "精炼厂：一层一层切"
	quest.118AF447A22EAB3B.quest_desc: ["钢锭四角、福鲁伊克斯玻璃线缆围一圈、中心一块石英块：FE 从这里进网络，一格接收器过 5 kFE/t。"]
	quest.118AF447A22EAB3B.quest_subtitle: "能量接收器"
	quest.118AF447A22EAB3B.title: "并网的那一头"
	quest.124E5A52D0F2A72D.quest_subtitle: "黎明石锭真的是一块好锭吗"
	quest.1359BE3C77A806B6.quest_desc: ["这是一种生活在深渊一层地面上泥土沙砾中的生物。"]
	quest.13B0197D7A36A72F.quest_desc: [
		"熔炼砖、炉体、炉缸、控制器、燃料箱，五样凑齐才立得起来：砖少了围不出立面，炉缸漏了烧化的金属全洒在地上，右键控制器点火，这间屋子才算开工。"
		"锭、方块、矿石丢进去化开，液体在炉里混，倒进浇注块配模具成型。粉碎线磨的粉、矿洞里挖的矿、原型机压好的锭都从这一炉里过一遍——钢除外，那是蒸汽时代末尾的事了。"
	]
	quest.13B0197D7A36A72F.quest_subtitle: "一炉水，一间屋子"
	quest.13B0197D7A36A72F.title: "熔炼炉（多方块）"
	quest.1408793381C97EC0.quest_desc: ["制作坚固外壳！"]
	quest.147A66BD1949E30A.quest_desc: [
		"做一台热力发电机！铁锭、锇锭、铜锭加一块熔炉：热量直接变电，不经过蒸汽。"
		"前期它就是通用机械的插座，锇不贵的时候多做几台，别让机器等电。"
	]
	quest.147A66BD1949E30A.quest_subtitle: "热电直出"
	quest.147A66BD1949E30A.title: "烧红一片铁"
	quest.14D88052708750EA.quest_desc: ["也许你的能量暂且还够用，但余烬晶体的产量日渐减少了。那么便来看看这个吧。"]
	quest.14E2E0D36E686107.quest_desc: [
		"打开炉顶活板门，投入满热值的装备，再投入若干灰烬晶体（灰烬晶体越多成功率越高），关闭活板门，即可开始强化。无论成功失败都会消耗所有的灰烬晶体。"
		"我们至今仍未知晓每次升级需要消耗多少灰烬晶体。"
	]
	quest.14E2E0D36E686107.quest_subtitle: "！？强强？！"
	quest.156E0D27F03959DC.quest_desc: ["坚固的列车机壳当然不会只用于火车，自动化！"]
	quest.156E0D27F03959DC.title: "开火车！"
	quest.15C7029E66E838F0.title: "最强的熔炉"
	quest.15E3CFD26FA821E0.quest_desc: ["木板、原木、铁板，拉动手柄把裸线裹上绝缘层。没有它，铜线只能当装饰品。"]
	quest.15E3CFD26FA821E0.quest_subtitle: "给铜穿上衣服"
	quest.15E3CFD26FA821E0.title: "原始包线机"
	quest.15F9B4F39AC30284.quest_desc: ["高压蒸汽锅炉、机器外壳、电动机拼在一起：蒸汽进去，电出来。这是蒸汽时代向电力时代递出的请柬。"]
	quest.15F9B4F39AC30284.quest_subtitle: "蒸汽与电的第一次握手"
	quest.15F9B4F39AC30284.title: "电动蒸汽发生器"
	quest.160B66057D2A2BC2.quest_desc: ["蒸汽驱动的挤压机。板和外壳从此可以流水线生产——虽然挤压原型机还得留着，它不要蒸汽。"]
	quest.160B66057D2A2BC2.quest_subtitle: "压力之下"
	quest.160B66057D2A2BC2.title: "蒸汽挤压机"
	quest.16B6A6EE43F7862F.quest_desc: [
		"//......说实话，我很难想象深渊之中居然也能看到如此明媚和谐的场景，到底是什么在制造阳光，地上那些随处可见的阳辉吗？"
		"//......我收回我刚刚说的话，这里终究是深渊，这里的怪物如此的可怕与强大。"
		""
		"{@pagebreak}"
		"(后续内容多过于重复，可前往进度查看，不作过多赘述。)"
	]
	quest.16B6A6EE43F7862F.title: "阳光平原"
	quest.16DD4183EE52B969.quest_desc: ["它就像手一样"]
	quest.174358FC22916BA6.quest_desc: ["散发着令人作呕的腐烂气息，我不想再接触这种东西了。"]
	quest.176BDCB97FADED40.quest_subtitle: "化为更聚焦的力量"
	quest.176BDCB97FADED40.title: "挑剔的工作台"
	quest.180BF6A63BBFFEB7.quest_desc: [
		"//......万幸的是下一层深渊之上有着数条枝蔓，似乎可以当作前往更深层次的桥梁？"
		"//......我再也不想经历第一次坠入深渊那种自由落地的感觉了，我害怕我的内脏将会变成外脏。"
	]
	quest.180BF6A63BBFFEB7.title: "深渊之井"
	quest.18F18597F7065BA1.quest_desc: ["由于精密构件用量较大，我把循环次数改为了3次并取消了副产物"]
	quest.18F18597F7065BA1.quest_subtitle: "你一定会想自动化它的"
	quest.18F18597F7065BA1.title: "这个构件很精密"
	quest.19A9BC6D92E82033.quest_desc: ["升级你的余烬机器！"]
	quest.19F5071BFF298275.quest_desc: ["从橡胶木里榨乳胶。乳胶干燥之后才是橡胶，橡胶是蒸汽时代一切密封件的原料。"]
	quest.19F5071BFF298275.quest_subtitle: "橡胶的前半生"
	quest.19F5071BFF298275.title: "蒸汽乳胶提取机"
	quest.1A1FA26750C0224F.quest_desc: ["塑料、框架、齿轮、桶，泡在乳胶里溶一遍，出来就是更高级的机器框架。工业先锋的分水岭。"]
	quest.1A1FA26750C0224F.quest_subtitle: "往液体里配东西"
	quest.1A1FA26750C0224F.title: "溶解室"
	quest.1B096E65D913FAC5.title: "安山物流"
	quest.1BEE6719FA581EC9.quest_desc: ["你可以在河边找到海蓝宝石，多收集点"]
	quest.1BEE6719FA581EC9.quest_subtitle: "像海一样"
	quest.1C94EF2659EE0C30.quest_desc: ["护甲越高，伤害越高。搭配法师法球也是种不错的选择。"]
	quest.1CB3010EC04C69B5.quest_desc: ["星辉魔法在高版本改动很大，不过别担心，任务会详细说明的"]
	quest.1CB3010EC04C69B5.quest_subtitle: "熬夜魔法"
	quest.1CB3010EC04C69B5.title: "星辉魔法"
	quest.1D1EE6A8C5530E1C.quest_desc: [
		"对未知的谨慎总是好的，我们不能使用这些科技"
		"至少在我们需要时再用也不迟"
	]
	quest.1D1EE6A8C5530E1C.quest_subtitle: "小心为上"
	quest.1D1EE6A8C5530E1C.title: "否"
	quest.1F47C907397E6D9B.quest_desc: ["好大的工作台，材料也好贵"]
	quest.1F47C907397E6D9B.title: "超大工作台"
	quest.1FAB7DD2DFC2148D.quest_desc: [
		"熔融塑料装进桶就是§a熔融塑料桶§f；贴着盛它的容器装一台§a导热框架§f，把它冷到 0℃，凝成§a塑料片§f。"
		"别只浇一桶。塑料片是电路板的底料，用得比你想象的多。"
	]
	quest.1FAB7DD2DFC2148D.quest_subtitle: "先灌桶，再冷却"
	quest.1FAB7DD2DFC2148D.title: "塑料，从气里长出来"
	quest.203117A926D8F616.quest_desc: ["生成机送 SE，工厂吃碎片。机身是钢板与镍板，不再经过阳光化合物板制造厂。"]
	quest.203117A926D8F616.quest_subtitle: "碎片压成化合物"
	quest.203117A926D8F616.title: "阳光化合物制造厂"
	quest.214D1C36178640C8.quest_desc: ["制作坍缩构件，你可以用它减少不需要的空间"]
	quest.2193FBA1E0B50F7E.quest_desc: ["或许是一种美味的食物？"]
	quest.21DC1429D7B64A75.quest_desc: ["木板加玻璃。乳胶从这里开始变成橡胶，湿的零件也从这里变干。"]
	quest.21DC1429D7B64A75.quest_subtitle: "晾干也是一种工艺"
	quest.21DC1429D7B64A75.title: "干燥原型机"
	quest.2228F6297919FB7A.quest_desc: ["这或许是你的第一个机器框架，但请注意，它也可以用作为拓展坞来使用。"]
	quest.2228F6297919FB7A.quest_subtitle: "机械核心"
	quest.22372738BD8CBD0F.quest_desc: [
		"原始包线机升级成蒸汽驱动，一次处理更多线，也不会再把绝缘层扯歪。"
		"这条线上三台机器各管一样：它出绝缘线，泵把液体送到该去的地方，储存器替机器扛住压力。都不必经，缺了就自己跑腿。"
	]
	quest.22372738BD8CBD0F.quest_subtitle: "线，还是那根线"
	quest.22372738BD8CBD0F.title: "蒸汽包线机"
	quest.223A36F78B6F517E.quest_desc: ["莫非这个世界的菌类都会生长到一立方米吗。"]
	quest.225B247E5319546F.quest_desc: [
		"单晶反应釜把一根西门子棒拉成 9N 单晶硅，60 秒、256 FE/t；激光切出四片§a9N 晶圆§f。"
		"从 M3 掩模起，光刻只认这一档。"
	]
	quest.225B247E5319546F.quest_subtitle: "一根棒，四片"
	quest.225B247E5319546F.title: "9N 晶圆"
	quest.22A7B9C9FE943FBF.quest_desc: [
		"§a压力室墙壁§f、压力室玻璃、压力室气阀、§a压力室接口§f围出一个封闭空腔，里面留一格放东西。墙能换成玻璃看里面，窟窿一个都不许有。"
		"接口管两件事：把气送进去，把料送进送出。压缩铁、空印刷电路板全在这间屋子里压出来。"
		"提示：空腔越小升压越快，先做三格见方。"
	]
	quest.22A7B9C9FE943FBF.quest_subtitle: "漏一格，压力就是零"
	quest.22A7B9C9FE943FBF.title: "围一间不漏气的屋子"
	quest.22BECA4CD5C08010.quest_desc: ["这把工具将用于旋转方块、链接余烬传输机器（发射器/接收器/中继器）、关闭管道侧面连接"]
	quest.22BECA4CD5C08010.quest_subtitle: "铁匠锤？扳手！"
	quest.24825836D1002DDD.quest_desc: ["像是黄色棉花糖一样，可为什么是蛙蛙呢？"]
	quest.24BB85BA4A497A2A.quest_desc: ["碎片 ×4 + 荧石粉 + 石英 + 镍锭 → 1。镍替换原来的钨锭。"]
	quest.24BB85BA4A497A2A.quest_subtitle: "一块凝固的太阳"
	quest.24BB85BA4A497A2A.title: "阳光化合物"
	quest.25D01AF8BA18BB6D.quest_desc: ["在一次偶然的炼金过程中，你将一些失败的产物混合在了一起，组成了这种奇妙的物品。它似乎在呼唤你前往某个地方。"]
	quest.25D01AF8BA18BB6D.title: "远古之证"
	quest.261BB0E84BC72316.quest_desc: ["高版本删除了所有望远镜，你现在需要用星盘寻找星座"]
	quest.261BB0E84BC72316.title: "开始观星！"
	quest.266C2F26B743AD58.quest_desc: ["每当我靠近它的时候就仿佛会传来一阵哭声。"]
	quest.268F9CB2F5488846.quest_desc: ["用蒸汽和激光把零件表面磨到镜面。晶体和精密件过一遍，后面装机才不卡。"]
	quest.268F9CB2F5488846.quest_subtitle: "金属也需要体面"
	quest.268F9CB2F5488846.title: "蒸汽抛光机"
	quest.26C109209120EE25.quest_subtitle: "与星共振"
	quest.2723FD4DEFF29767.quest_desc: ["水车的应力被减半了，减慢你的转速"]
	quest.2723FD4DEFF29767.title: "水车仙人"
	quest.28578D0264003331.quest_desc: ["每次攻击消耗25余烬能量，蓄力可增加伤害。"]
	quest.285AC19CE5FBC3ED.quest_desc: [
		"处理致密矿石，把有用的部分和废石分开，不需要电网。产物概率比电动的低一点，蒸汽时代够用。"
		"这台只认九种金属，别的矿种它洗不了；全矿种的洗选与选别在电力时代的通用选矿机里，下一章有专门的支线。"
		"矿处理线的第一道，往后还有电解器和采石机。原料侧的活蒸汽就够用，电力时代来了整条换掉——那已经不关它的事。"
	]
	quest.285AC19CE5FBC3ED.quest_subtitle: "把石头还回去"
	quest.285AC19CE5FBC3ED.title: "蒸汽矿物分离器"
	quest.28BD6CAC160150A9.quest_desc: [
		"做一个富集仓！磨好的矿粉进去，同种矿的粉出两份，是这条线上最便宜的倍增。"
		"配方只要灌注合金、基础电路、铁锭和钢制机壳——一个锇都不要，早早就该有。"
		"它的下游是通电冶炼炉：粉进炉子烧成锭，两段接起来才是完整的倍增。"
	]
	quest.28BD6CAC160150A9.quest_subtitle: "第一段：只吃灌注合金"
	quest.28BD6CAC160150A9.title: "矿翻倍的第一站"
	quest.292AC0D0FB6D3181.title: "圆石生万物！"
	quest.2B3668985A58348C.quest_desc: ["也许之前的那个太小了不够用呢？"]
	quest.2C027D8994527225.quest_desc: [
		"六节管道，铜板加青铜外壳。普通蒸汽只能走管道，不能走胶囊。"
		"相邻放置也能传压，但长距离还是老老实实铺管。"
	]
	quest.2C027D8994527225.quest_subtitle: "流体喜欢铜"
	quest.2C027D8994527225.title: "蒸汽管道"
	quest.2C447CF0BBF40408.quest_desc: [
		"铜板围壳、铜机壳做胆、里面塞一台熔炉。这台铜锅炉是 IU 原始与蒸汽两代的通用件："
		"原型流体加热器、乳胶提取机、原型流式腐蚀釜、蒸汽储存器、蒸汽流体加热器、固液反应釜、锅炉储罐，里面装的都是它，别只做一个。"
	]
	quest.2C447CF0BBF40408.quest_subtitle: "一套锅炉，到处复用"
	quest.2C447CF0BBF40408.title: "铜锅炉"
	quest.2C9F0BC4B2779D1F.quest_desc: [
		"§a容量升级§f加机器和管道里的气容量，§a速度升级§f让机器转得更快——气也烧得更快。"
		"都塞进机器右上角的升级槽。管道分段装容量升级，长距离送气才不会一路掉压。"
	]
	quest.2C9F0BC4B2779D1F.quest_subtitle: "25 张容量，10 张速度"
	quest.2C9F0BC4B2779D1F.title: "多存点，再快一点"
	quest.2E5CFA0A0916AA4C.quest_desc: [
		"样板编码终端把配方写成样板，接口收样板，供应器把料推给机器。三件凑齐，网络才从仓库变成工厂。"
		"再往后接导入总线与导出总线，进出也不再靠手。"
	]
	quest.2E5CFA0A0916AA4C.quest_subtitle: "样板与自动合成"
	quest.2E5CFA0A0916AA4C.title: "让它自己动手"
	quest.2E72178081573E6E.quest_desc: [
		"空印刷电路板先送进§a紫外线灯箱§f照：照得越久，后面蚀刻成功的概率越高，但进度会越来越慢，别照过头。"
		"照完丢进§a蚀刻器§f过酸，没被光固化的铜被吃掉，线路就留在板上。蚀刻器烧到 50℃ 以上更快，代价是酸耗得更凶。"
		"最后装上元件。这一步是化学蚀刻，别和电力时代的光刻搞混——光刻打的是晶圆，不是板子。"
	]
	quest.2E72178081573E6E.quest_subtitle: "电路板三步"
	quest.2E72178081573E6E.title: "曝光、腐蚀、装元件"
	quest.2E74C539C92E94EF.quest_desc: [
		"//......我透过深渊之眼下潜到了这里，那片浓雾似乎有着减缓下降的功能，我并未感受到很快的坠落速度，希望不是我的错觉。"
		"//......但我发现只要我产生了向上攀爬的念头，我就感到一阵头晕眼花与视物模糊，难道这深渊是&0活的&r？"
		"//......&4它&r并不希望我离开这里，我得想办法&4逃出去&r。"
	]
	quest.2E74C539C92E94EF.title: "潜入深渊"
	quest.2EC7210E5C7222BA.quest_desc: [
		"夜晚寻找太古魔像，击杀后用其掉落物合成 “远古法典” 。"
		"不管你是不是第一次游玩这个mod，我都希望你不要去查询一些过时的，不正确的攻略。"
	]
	quest.2EC7210E5C7222BA.quest_subtitle: "古代法典"
	quest.2EECA8F74F7C235B.quest_desc: ["利用你的搅拌机大量获取黄铜"]
	quest.2EECA8F74F7C235B.quest_subtitle: "真正的合金"
	quest.2EECA8F74F7C235B.title: "量产黄铜"
	quest.2F418266BAA45470.quest_desc: ["我相信你很快就会用用上的。"]
	quest.2F418266BAA45470.quest_subtitle: "单片眼镜"
	quest.2F67C84DFB5047F8.quest_desc: ["穿越异界，系统降临"]
	quest.2F67C84DFB5047F8.title: "阶段一"
	quest.2FFEAF4A6C810F1B.quest_desc: [
		"结晶器里，850 mB §a高纯三氯硅烷§f在炽热硅芯上分解沉积，长出一根§a西门子多晶硅棒§f。"
		"温度不够只会得到一堆粉料，所以它只能进结晶器，别往熔炉里塞。"
	]
	quest.2FFEAF4A6C810F1B.quest_subtitle: "在炽热的硅芯上长"
	quest.2FFEAF4A6C810F1B.title: "西门子多晶硅棒"
	quest.306FF3E1D993000C.quest_desc: ["像是紫色棉花糖一样，可为什么不甜呢？"]
	quest.31204D143AE71F6C.quest_desc: [
		"§a空气压缩机§f往燃料槽塞任何一种熔炉燃料就能产压缩空气，再用管道接到压力室的气阀或接口上。"
		"别往里倒燃料桶——液体燃料归液体压缩机管。燃料越耐烧，压力爬得越久；前置没别的动力源时，它就是全包的心脏。"
	]
	quest.31204D143AE71F6C.quest_subtitle: "烧煤换压力"
	quest.31204D143AE71F6C.title: "让它开始喘气"
	quest.3144BDD432A185BD.quest_desc: ["只从安装面输入蒸汽，其余方向只输出。把它当成蒸汽电池，机器挨着它就不怕断供。"]
	quest.3144BDD432A185BD.quest_subtitle: "存一点压力"
	quest.3144BDD432A185BD.title: "蒸汽储存器"
	quest.327E8839891E08EE.quest_desc: [
		"MMCR 塔器里，4000 mB §a三氯硅烷§f歧化成 1000 mB §a硅烷§f，另出 3000 mB 四氯化硅。四氯化硅配氢回三氯硅烷，氯是闭路的。"
		"硅烷本身就是一次精馏级的提纯，所以从它手里出来的硅比西门子棒再高一档。"
	]
	quest.327E8839891E08EE.quest_subtitle: "沸点 −112℃"
	quest.327E8839891E08EE.title: "硅烷：歧化出来的气"
	quest.32A506E2D35153FF.quest_desc: [""]
	quest.32BB82143A42C454.quest_desc: [
		"器件级晶棒进激光处理厂切成四片§a12N 晶圆§f，M6 掩模和 IU 的高阶芯片都吃它。"
		"同一根棒在制造机上锯成四片器件级晶圆，qmd 的高级、精英处理器走那条。"
	]
	quest.32BB82143A42C454.quest_subtitle: "一根棒，两个去处"
	quest.32BB82143A42C454.title: "12N 晶圆"
	quest.32D603DE7A5BA336.quest_desc: ["每次攻击消耗25余烬能量，蓄力不增加伤害。"]
	quest.32D77C0E69A7F0F5.quest_desc: ["我喜欢这种植物，看起来很美味，有一种盎然的生意在其中。"]
	quest.3351625F36EC0194.quest_desc: ["穿戴完整的套装可以获得一定的摔落保护，帮助你在深渊下潜。"]
	quest.33CA917A7FF636A6.quest_desc: [
		"很好，现在终于能够挖矿了。"
		""
		"可恶，难道我辛辛苦苦制作的燧石镐，连一块铁都挖不下来吗。我到底该怎么制作更强大的镐子来供我驱使。"
	]
	quest.34201481CF72171A.quest_desc: ["这是一种拙劣的合金锭，似乎只能用于某些土制方法制作的机器。"]
	quest.34201481CF72171A.quest_subtitle: "对前世记忆的仿造"
	quest.34201481CF72171A.title: "拙劣的合金"
	quest.34D552E8494DF63D.quest_desc: ["用搅拌器制作通红的坚固合金，再用水进行冷却"]
	quest.34D552E8494DF63D.quest_subtitle: "这样的合金有什么用呢"
	quest.34D552E8494DF63D.title: "坚固的合金"
	quest.34DB73A960C0D660.quest_desc: ["原型泵的成年版：通上蒸汽与水，它自己把液体送到你要去的地方。"]
	quest.34DB73A960C0D660.quest_subtitle: "终于不用长按右键"
	quest.34DB73A960C0D660.title: "蒸汽泵"
	quest.34E2B4C7D5914293.quest_desc: ["RE 电池配元件模板就是增强能量元件。它把机器的电等级往上推一格，后面的高级机台离不开。"]
	quest.34E2B4C7D5914293.quest_subtitle: "往上抬一档"
	quest.34E2B4C7D5914293.title: "元件:增强能量"
	quest.35673E8862ECC966.quest_desc: ["熔炼炉的袖珍版：拿熔融矿石胶囊右键它，上方出现粗金属锭，再右键取走。适合分散的小规模铸造。"]
	quest.35673E8862ECC966.quest_subtitle: "一炉一小块"
	quest.35673E8862ECC966.title: "微型熔炉"
	quest.35B9A0B50B6D5A7C.quest_desc: [
		"轧机把锭压成板、把板压成薄片，是蒸汽时代最后的成型设备。"
		"它必须架在强化铁砧上，所以整条线走到这里，才算是把钢用上了。"
	]
	quest.35B9A0B50B6D5A7C.quest_subtitle: "得先有一块好砧"
	quest.35B9A0B50B6D5A7C.title: "蒸汽轧机"
	quest.36A0B043CD532395.quest_subtitle: "流体喜欢铜"
	quest.38388EADB17FD482.quest_desc: ["现在你需要匍匐在地上寻找石子或者是rock？然后再去河岸搜索一些沙砾挖掘后掉落的燧石，接着将它分解为flint shard（燧石碎片）。然后与破坏树叶后掉落的木棍组合起来，你将获得一把燧石小刀。"]
	quest.38388EADB17FD482.quest_subtitle: "燧石，但不是打火机"
	quest.38388EADB17FD482.title: "物理，很神奇吧"
	quest.389FD240EFC2D9A8.quest_desc: ["用共振法杖寻找水晶石矿石，它将与法杖共振"]
	quest.389FD240EFC2D9A8.quest_subtitle: "藏于地下"
	quest.38AE7BE9A1702B16.quest_desc: ["用星盘寻找降星点，你会看到白色光柱，把工作台和4个大理石丢进去"]
	quest.38AE7BE9A1702B16.quest_subtitle: "光芒会教会它聆听"
	quest.38E59F0A75D5FEBB.quest_desc: ["驱动器里的东西，在终端里看得见、拿得出、放得进。网络有了终端才叫人能用。"]
	quest.38E59F0A75D5FEBB.quest_subtitle: "ME 终端"
	quest.38E59F0A75D5FEBB.title: "开一扇窗"
	quest.39224A23A36F5D89.quest_desc: [
		"钢要配一块钢做的砧。普通铁砧敲不动重活，强化铁砧可以。"
		"它还是蒸汽轧机的地基——没有它，轧机连立都立不起来。"
	]
	quest.39224A23A36F5D89.quest_subtitle: "配得上钢的砧"
	quest.39224A23A36F5D89.title: "强化铁砧"
	quest.39E580844A461AC5.quest_desc: ["熔融材料从模具里挤成线材和杆件。和轧机配一对，板与杆都不缺。"]
	quest.39E580844A461AC5.quest_subtitle: "挤出来就是一根"
	quest.39E580844A461AC5.title: "蒸汽挤出机"
	quest.39F17AE9D43DCF5C.quest_desc: ["哈哈哈，天不亡我，我现在就将那铁矿斩于镐下。"]
	quest.39F17AE9D43DCF5C.quest_subtitle: "似乎更强大了？"
	quest.39F9A7586935F24F.quest_desc: [
		"打一把§a燧石刀§f。这是这一版塞给你的第一件工具，也是「石头」阶段的通行证。"
		"交掉这一格，后面的石器、窑、砖才认你。上面那一格只是让你站住脚，别在这里停太久。"
	]
	quest.39F9A7586935F24F.title: "获取燧石刀"
	quest.3A8A79B642BC2C15.quest_desc: ["合成终端把工作台搬进网络：配方要的东西网络里有，它自己取；做出来的东西自己回去。"]
	quest.3A8A79B642BC2C15.quest_subtitle: "合成终端"
	quest.3A8A79B642BC2C15.title: "在窗里合成"
	quest.3B777A65814CB1E6.quest_desc: [
		"把油抽上来。气举、机械泵，或者干脆拎个桶下去，都行。"
		"本包的原油已经统一成 IU 的六种油品，气动的精炼厂一样收。"
	]
	quest.3B777A65814CB1E6.quest_subtitle: "黑的，黏的，往后全是它"
	quest.3B777A65814CB1E6.title: "第一桶原油"
	quest.3C36940FAC6404ED.quest_desc: ["植物纤维，植物绳。看起来很简单，对吧？割草，捡纤维，搓绳子。但如果你割了十丛草只掉了两根纤维，请不要质疑概率——概率是给有工作台的人准备的，你现在没有。"]
	quest.3C36940FAC6404ED.quest_subtitle: "植物纤维，不是植物人"
	quest.3C36940FAC6404ED.title: "草：我招谁惹谁了"
	quest.3CAB66D5F17CA3F3.quest_desc: [
		"做一个 ME 驱动器：钢板块四角、福鲁伊克斯粉、中心一台能源接收器。"
		"驱动器是插槽，存储元件是仓库。一块 1k 元件存 1024 字节，够放几箱东西。"
		"不够就往上做：4k、16k、64k、256k 在旁边的支线上。"
	]
	quest.3CAB66D5F17CA3F3.quest_subtitle: "驱动器与存储元件"
	quest.3CAB66D5F17CA3F3.title: "先有个仓库"
	quest.3D06F75481652692.quest_desc: [
		"灌注合金进灌注机，20 mB 钻石液压进去，就是强化合金。"
		"原子合金与终极电路都等它。"
	]
	quest.3D06F75481652692.quest_subtitle: "强化合金"
	quest.3D06F75481652692.title: "灌注合金再灌一次"
	quest.3D94735C2E3745DD.quest_desc: [
		"将工具，护甲或武器放置在黎明石砧后放置一个太古动力核心并用铁匠锤或自动锤敲击可以使该物品获得热量条。你甚至可以放两个太古动力核心来获得一个有热量条的太古动力核心。（"
		""
		"{@pagebreak}"
		"智械机关是一种简单的防具的嵌入升级。穿着这个升级的防具可以提升杀死生物所获得的经验的数量。增加的经验数量随强化的等级增加而增加。"
		""
		"当恐怖徽章嵌入到你的盔甲时，某些怪物会害怕你。你将获得恐吓怪物的能力，怪物无法攻击你，除非你攻击它们。恐惧这些徽章持有人的怪物的比例会随升级的等级增加而增加。"
		""
		"烈焰屏障是一种装甲强化装置，在装备了拥有这种升级的护甲并且拥有便携式灰烬能量储备时，如果受到攻击，那么就会在玩家身上残绕烈焰保护玩家。攻击到玩家的生物会着火并造成一定伤害。伤害随升级的等级增加而增加。"
		"{@pagebreak}"
		"散射枪管可用于灼热射线枪的升级配件，获得该升级的物品会得到一个等级的“衍射”的效果。可以将灼热射线枪的弹药变为4颗火球，此外每增加一级的“衍射”效果会让灼热射线枪每次发射的弹丸数量+1。"
		""
		"聚焦镜片用于灼热射线枪的强化组件，能够让灼热射线枪的射线具有穿透实体的能力，将该升级装在带有“衍射”升级的灼热射线枪时会使弹丸获得追踪的能力。"
		""
		"热炙器是一个简单的升级，可以应用于积累了热量的物品。嵌入这个升级后，所有被拥有这个升级的工具挖掘/杀死的方块/生物的掉落都会自动烧炼并产生相应的物品损耗。升级的等级越高，燃烧的伤害越高。需要携带式灰烬能量才能运作。"
		"{@pagebreak}"
		"煤渣喷气机是一种装甲强化配件，可通过黎明石砧安装在护甲上。装备带有该升级的护甲会消耗少量灰烬能量使玩家进行疾跑时能向前方突进3格的距离。"
		""
		"爆破核心是造成爆炸的升级。当嵌入到工具，使用工具挖掘方块后，它将破坏附近的方块。当嵌入到武器时，会发生爆炸并伤害附近的生物。当嵌入到护甲时，当护甲受到损耗时，会发生爆炸并吹开附近的生物。所有三种效果都随着强化升级的等级的提高而增加。"
		"{@pagebreak}"
		"法师法球是一种工具和武器升级，它可以使得具有这种升级的工具拥有发射灰烬能量弹丸的能力。需要便携式灰烬能量来启动。当使用（左键）这个工具时，该工具就可以发射一个灰烬能量弹丸。弹丸的发射间隔等同于工具的复原时间。弹丸的尺寸和伤害随升级的等级增加而增加。"
		""
		"由于法师法球的强化允许工具或者武器射击由灰烬能量形成的弹丸。因此添加了法师法球强化的工具或者武器也可以接受改变弹射物性状的升级强化。(造成法术伤害)"
		""
		"共鸣之铃是嵌入到工具的升级。它能通过拥有此升级的工具右键敲击某类方块，使得附近的同类方块发光。共鸣的范围随升级的等级增加而增加。"
	]
	quest.3D94735C2E3745DD.quest_subtitle: "？！强强！？"
	quest.3EEBC200020CEC1A.quest_desc: ["接上蒸汽和钻管，它会一路向下把工作区域的方块挖出来。记得在它下面留空间，也记得回来收矿。"]
	quest.3EEBC200020CEC1A.quest_subtitle: "往地下钻"
	quest.3EEBC200020CEC1A.title: "蒸汽采石机"
	quest.3F5A0000000000C1.quest_desc: [
		"粉碎原型机把一份原矿磨成两份碎矿，磨过的矿在同样一炉里能多出一倍金属。磨机在现实里干的也是这件事：颗粒磨细，脉石才松得开，后面的选别才有得选。"
		"这一格是整条矿线的入口，洗选、选别、电积都从它这里接出去。磨完直接进熔炼炉也行，那是最省事的一条路，代价是金属收不回全份。"
	]
	quest.3F5A0000000000C1.quest_subtitle: "R1 · 2.0 锭/矿 · 代价：无"
	quest.3F5A0000000000C1.title: "碎矿：把矿磨开"
	quest.3FFD6CD6131BB41E.quest_desc: ["把板切成杆、把块切成片。切割是很多零件的最后一道工序。"]
	quest.3FFD6CD6131BB41E.quest_subtitle: "一刀两断"
	quest.3FFD6CD6131BB41E.title: "蒸汽切割机"
	quest.40110213F98998F5.quest_desc: [
		"多方块蒸馏器把 1000 mB 三氯硅烷切成 850 mB §a高纯三氯硅烷§f 和 150 mB 四氯化硅。"
		"这一步按沸点切掉 BCl₃（低沸）和 PCl₃（高沸），硼磷残留降一个数量级——6N 与 9N 的分界就在这根塔上。"
		"切下来的重组分回氯循环，别倒。"
	]
	quest.40110213F98998F5.quest_subtitle: "精馏塔按沸点切"
	quest.40110213F98998F5.title: "高纯三氯硅烷"
	quest.415E14738BE3B48B.quest_desc: [
		"做一个充能器！钢板立三列，塞两块充能赛特斯石英——这就是 DJ2 那台充能器的样子。"
		"两件事：把赛特斯石英充成充能赛特斯石英（做福鲁伊克斯水晶用），以及给存储元件与便携终端补电。"
		"AE 后面五台机器全绕着它转，先把它摆好。"
	]
	quest.415E14738BE3B48B.quest_subtitle: "AE 的第一台"
	quest.415E14738BE3B48B.title: "把石英充成水晶"
	quest.4180DCBFB8DD7D48.quest_desc: ["八块铁板围出一个锭模。放进浇注块，再把液体倒进去，锭就回来了。"]
	quest.4180DCBFB8DD7D48.quest_subtitle: "把水变回锭"
	quest.4180DCBFB8DD7D48.title: "铸型模具"
	quest.418DAE08F5E9ADBF.quest_desc: ["我们需要这些科技，但愿不会出什么岔子"]
	quest.418DAE08F5E9ADBF.quest_subtitle: "不会出问题的"
	quest.418DAE08F5E9ADBF.title: "是"
	quest.41BE19EC32B35C5C.quest_desc: ["//......来自深渊二层的怪物，生活在岩壁之中"]
	quest.42223DDF2528A3FB.quest_desc: [
		"//......该死的，&4它&r分明是想将我拉入深渊，可为什么我无法从深渊之眼下方继续下潜。"
		"//......所幸我有携带飞路粉的习惯，我可以试着通过飞路粉返回，从而避免那该死的攀返症。"
	]
	quest.42EBA0AD040439BF.quest_desc: ["神之手的力量是无穷的"]
	quest.42EBA0AD040439BF.title: "神之手"
	quest.43D5726B73FFD4E3.quest_desc: [
		"外壳、控制器、储罐、加热器、热交换器：五件套围起来才是正经锅炉，每刻 1mB 水换 2mB 蒸汽，效率是小型锅炉的两倍。"
		"控制器自己开不了，必须靠热交换器：往加热器供热，往储罐注水。热交换器里要十根线圈和一个铁氧体环形电感。"
	]
	quest.43D5726B73FFD4E3.quest_subtitle: "这次是真的锅炉房"
	quest.43D5726B73FFD4E3.title: "蒸汽锅炉（多方块）"
	quest.43F8EA18EEE5CDCD.quest_desc: ["本体的顶配储能。往后接的是聚变与裂变那套电网，这里就是它的缓冲。"]
	quest.43F8EA18EEE5CDCD.quest_subtitle: "终极能量立方"
	quest.43F8EA18EEE5CDCD.title: "存 128 MFE"
	quest.44F6506A686E7FA4.quest_desc: ["三个 64k 元件：256k，AE2 本体最高的一档；再往上就要靠附属了。"]
	quest.44F6506A686E7FA4.quest_subtitle: "存储元件 256k"
	quest.44F6506A686E7FA4.title: "本体到顶"
	quest.469AD01E07552C3C.quest_desc: [
		"用你的动力合成器制作粉碎轮"
		"当心，不要掉下去"
	]
	quest.469AD01E07552C3C.quest_subtitle: "自从有了粉碎轮之后家里只剩粉碎轮了"
	quest.4717D5F0DFBD7A6C.quest_desc: [
		"如果你有足够的毅力和时间的话，你甚至可以手搓完机械动力章节"
		"另外，你需要用指杆制作你的第一个黄铜机壳来制作机械手"
	]
	quest.4717D5F0DFBD7A6C.title: "手搓仙人"
	quest.47288C78398A483D.quest_desc: ["制作电镀外壳，再合成电力机壳"]
	quest.47288C78398A483D.quest_subtitle: "又是套娃"
	quest.47288C78398A483D.title: "电力机壳"
	quest.47323966F5E2572C.quest_desc: ["生长于伞树上的水果"]
	quest.486569B3D357D2B4.quest_desc: [
		"做一个冶金灌注机！最左格放灌注料，中间放待灌的东西，一台只吃一种灌注液。"
		"灌注合金、基础电路、强化黑曜石粉、强化黑曜石锭全从它出来，锇莹黑合金的灌注路也走它。"
		"做两台比来回换料省事——灌注液换一次要清管。"
	]
	quest.486569B3D357D2B4.quest_subtitle: "红石、钻石、黑曜石都从这儿灌"
	quest.486569B3D357D2B4.title: "一台机器，两条料路"
	quest.4869FCEABEB4800E.quest_desc: ["三个 16k 元件：64k。合成存储元件与大容量便携元件都从这里切。"]
	quest.4869FCEABEB4800E.quest_subtitle: "存储元件 64k"
	quest.4869FCEABEB4800E.title: "三份 16k"
	quest.48BEE62B80F62549.quest_desc: ["或许，你真的可以挖一点东西了？"]
	quest.49C6261827C7A7B3.quest_desc: ["铁板做壳，铜板做衬，中间一颗粉碎球。右键投料、右键取料，你站在旁边就是它的动力。"]
	quest.49C6261827C7A7B3.quest_subtitle: "手摇的磨"
	quest.49C6261827C7A7B3.title: "粉碎原型机"
	quest.49CD2F84291610CC.quest_desc: [
		"充能赛特斯石英、下界石英、红石粉丢进水里：福鲁伊克斯水晶。"
		"AE 的每一块玻璃、每一根线、每一个处理器都从它开始，一次多泡几颗。"
	]
	quest.49CD2F84291610CC.quest_subtitle: "福鲁伊克斯水晶"
	quest.49CD2F84291610CC.title: "水、石英、红石"
	quest.4A1B91231661F70F.quest_desc: ["你的第一个机械动力机壳"]
	quest.4A1B91231661F70F.quest_subtitle: "安山时代"
	quest.4A3C44501E2E4EBE.quest_desc: ["很原始的发电机，终于不要靠蒸汽了"]
	quest.4A3C44501E2E4EBE.quest_subtitle: "终于有电了"
	quest.4A3C44501E2E4EBE.title: "发电机"
	quest.4A80AEC1F882B8F5.quest_desc: ["//......来自深渊二层的怪物，生活在岩壁之中"]
	quest.4AC45BD5DE566B0C.quest_desc: [
		"做一个锇压缩机！锇锭进去，锇板与锇粉出来：强化黑曜石锭、锇荧锭都从它压出来。"
		"配方要灌注合金、高级电路和一个桶，是第二段的第一台——做到这里，锇才真的开始不够用。"
		"合金的两条路都长在它后面。"
	]
	quest.4AC45BD5DE566B0C.quest_subtitle: "第二段：从这里开始要锇"
	quest.4AC45BD5DE566B0C.title: "把锇压成件"
	quest.4B07E60F980AB930.quest_desc: ["再四倍。到了这一档，一台立方就能带住一整排机器的启停。"]
	quest.4B07E60F980AB930.quest_subtitle: "精英能量立方"
	quest.4B07E60F980AB930.title: "存 32 MFE"
	quest.4C2722480E36EC49.quest_desc: ["机身的第一份工作：烧水。每三刻消耗 2mB 水，产出 2mB 蒸汽。"]
	quest.4C2722480E36EC49.quest_subtitle: "每三刻，两桶水"
	quest.4C2722480E36EC49.title: "蒸汽锅炉"
	quest.4C818472A5267465.quest_desc: ["我们在末地发现了这种神奇的物质，或许这就是我们需要的"]
	quest.4C818472A5267465.quest_subtitle: "神奇的物质"
	quest.4D7D787C9864FCEF.quest_desc: ["奇特的菌类物质好像，它似乎还会发光，难道这是诱捕某种微小生物的方式吗？"]
	quest.4D92FDC6EA6BDD71.quest_desc: [
		"汇聚生灵之气，调转玄妙之间，聚火成堆。"
		""
		"柴堆，司炼造、调灵、转化。"
	]
	quest.4D92FDC6EA6BDD71.quest_subtitle: "柴堆？小熔炉！"
	quest.4E2996D1346A91DD.quest_desc: ["我发现粘土与沙子可以混合成一种奇妙的物质，它似乎蕴含着某种神奇的力量。或许，我可以通过柴堆把它们烤干？"]
	quest.4F29CA92AAE1AE91.quest_desc: ["再上一层：大部分机器同时开工时，瓶颈就不在电线上了。"]
	quest.4F29CA92AAE1AE91.quest_subtitle: "精英线缆"
	quest.4F29CA92AAE1AE91.title: "一根过 80 kFE/t"
	quest.50E6857A8D8A924B.quest_desc: ["在通过这扇门的同时，你的脑海中涌入了大量的信息。原来，这里叫作下界。"]
	quest.50E6857A8D8A924B.title: "远古回响"
	quest.50FFF3DA2CF84C7F.quest_desc: ["普通蒸汽在加热器里烧一遍就是过热蒸汽。它不能走蒸汽管道，只能走流体管道或胶囊。"]
	quest.50FFF3DA2CF84C7F.quest_subtitle: "再烧一次"
	quest.50FFF3DA2CF84C7F.title: "过热蒸汽"
	quest.5395E48294293E81.quest_desc: [
		"炼金台每接入一个熵演枚举器，便允许两个正确的元素象征与原材料错配，在此基础上每额外接入一个，则额外多允许一个正确的元素象征错配。"
		""
		"炼金台每接入两个熵演枚举器，便允许存在一个错误的元素象征。"
		"想要偷懒，就要接受最严厉的惩罚。"
	]
	quest.5395E48294293E81.quest_subtitle: "我想你可能会喜欢这个"
	quest.53CD91001F021592.quest_desc: ["经过你的猎杀研究，这种生活在深渊一层地面上的生物的鳞片与皮毛具有很好的防火效果。如果把它制作成一种盔甲会怎么样呢？"]
	quest.5400DADCBBB2C09A.quest_desc: ["如你所见，将这个机器对着炼金台放置即可，然后使用纸进行刻录配方。"]
	quest.5400DADCBBB2C09A.quest_subtitle: "雕印版？记事本！"
	quest.541A81224FDBD420.quest_desc: [
		"通过熔炼炉熔炼你的矿物吧，并将流体导出到压印基座，接着在压印基座上方空出一格放置压印锤。"
		""
		"为你的第一块金属锭而欢呼雀跃吧。"
	]
	quest.541A81224FDBD420.quest_subtitle: "熔炉？！"
	quest.54292046716034B6.quest_desc: ["我曾在森林的树荫底下发现过这些自然造物，它们似乎具有某种特别的魔力？"]
	quest.54A917D73EE764DB.title: "黄铜物流"
	quest.553DE08FF8207EFC.quest_desc: [
		"你终于不用站在粉碎原型机旁边。蒸汽粉碎机一次吃更多，也快得多。"
		"蒸汽加工线的头一道。后面挤压、切割、挤出、提取、抛光、乳胶依次接手，一条线排下来板、杆、胶都不缺；机器都要压力，主线却不从这里过。"
	]
	quest.553DE08FF8207EFC.quest_subtitle: "不用自己动手了"
	quest.553DE08FF8207EFC.title: "蒸汽粉碎机"
	quest.55F9AE8981565D51.title: "终于不要手搓变速了"
	quest.560D11F9F119EB2B.quest_desc: [
		"九个压缩铁锭在压力室里压成一块§a压缩铁块§f，压力至少 2 bar。"
		"它既是储料也是建材。往后气动的东西只会越来越吃铁，早点压一批屯着。"
	]
	quest.560D11F9F119EB2B.quest_subtitle: "2 bar 才压得动"
	quest.560D11F9F119EB2B.title: "九块铁，压成一块"
	quest.56D4CDDFAE01BAD1.quest_desc: ["来自地狱的植物。"]
	quest.56E002766340A469.quest_desc: ["做一个钢制机壳！通用机械的每一台机器需要它"]
	quest.56E002766340A469.title: "先做一块壳"
	quest.56E66A5D88A8BE7E.quest_desc: [
		"元件模板、钢板、镍板、银板与青铜板。原来的复合金属板、碳板与钍都换成本时代金属。"
		"生成机、制造厂与 SE 线都从这一件开始。"
		"SE 线从这一件起：生成机立起来，制造厂把碎片压成阳光化合物，最后一条导管把电送回去。本时代它只做储备，主线不从这里走。"
	]
	quest.56E66A5D88A8BE7E.quest_subtitle: "阳光能量的触头"
	quest.56E66A5D88A8BE7E.title: "元件:SE"
	quest.56EE1D8ACA1EF3C5.quest_desc: [
		"基础能量立方存 2 MFE，机器断电的那一阵靠它顶着。"
		"后面还有进阶、精英、终极三档，都从这块起。"
	]
	quest.56EE1D8ACA1EF3C5.quest_subtitle: "基础能量立方"
	quest.56EE1D8ACA1EF3C5.title: "一块砖大的电池"
	quest.5754619E9CA9D0F0.quest_desc: ["割胶碗收来的乳胶在这里聚成干胶，烧一遍就是塑料。塑料是高级机器框架的必需品。"]
	quest.5754619E9CA9D0F0.quest_subtitle: "橡胶变塑料"
	quest.5754619E9CA9D0F0.title: "乳胶处理单元"
	quest.57E4815EC1E82AC0.quest_desc: [
		"蒸汽提供热量与加压，真正的化学过程还得靠电流转换器给的电流。"
		"它可以把水拆成氢和氧，是你第一次真正接触气体工艺。"
	]
	quest.57E4815EC1E82AC0.quest_subtitle: "通了电才算完整"
	quest.57E4815EC1E82AC0.title: "蒸汽电解器"
	quest.57EE18783CC19EED.quest_desc: [
		"压缩铁锭不认锤子，只认压力。还没有压力室的时候，最土的办法是：把铁锭扔在地上，引一桶 TNT 炸开它——§a爆炸合成§f会给你压缩铁锭，五块里碎一块。"
		"八块石头围一块压缩铁锭，得到八块§a强化石头§f；四块强化石头拼一块§a强化石砖§f，压力室的墙、接口、气阀都从它切出来。"
		"提示：一次炸一块，散开摆，捡得过来。"
	]
	quest.57EE18783CC19EED.quest_subtitle: "没有它，一间屋子都立不起来"
	quest.57EE18783CC19EED.title: "把铁压成压缩铁"
	quest.585589616E4ADF3F.quest_desc: [
		"机械动力的教程很多，因此任务的描述会略简略"
		"另外，本整合包禁用了所有动态结构"
	]
	quest.585589616E4ADF3F.quest_subtitle: "简单的合金"
	quest.585589616E4ADF3F.title: "第一块合金"
	quest.586A7BE62B560256.quest_desc: ["你吃了烧心的写字楼盒饭烧心而死，穿越异世界。叮，觉醒科技登神系统。叮，现奖励新手大礼包。"]
	quest.586A7BE62B560256.quest_subtitle: "我穿越了？"
	quest.586A7BE62B560256.title: "欢迎来到水槽之旅"
	quest.591FF33BBB5E6A4D.quest_desc: [
		"铜锭灌红石是灌注合金，锇锭灌红石是基础电路。机器外壳塞合金，机器脑子里塞电路。"
		"一次多灌几份：第一段三台、第二段的压缩机和合金都要吃这一批料。"
	]
	quest.591FF33BBB5E6A4D.quest_subtitle: "灌注合金与基础电路"
	quest.591FF33BBB5E6A4D.title: "红石灌进铜里"
	quest.59416744F8E7ABE8.quest_desc: ["将黑曜石粉碎再注入熔岩得到坚固板！你可以用于制作下一级的机壳"]
	quest.59416744F8E7ABE8.quest_subtitle: "我想它一定很硬"
	quest.59416744F8E7ABE8.title: "坚固板"
	quest.599B38AABF39AFD3.quest_desc: ["合金外壳再裹一层，导线换粗。线缆只要合金与电路，机器不用换。"]
	quest.599B38AABF39AFD3.quest_subtitle: "高级线缆"
	quest.599B38AABF39AFD3.title: "一根过 20 kFE/t"
	quest.59AD9573BD5BD642.quest_desc: ["这种力量，前所未有的力量在指掌间迸发，你似乎能将万物都碾磨成碎渣。"]
	quest.59AD9573BD5BD642.quest_subtitle: "研磨一些东西"
	quest.5A1B000000000001.quest_desc: [
		"机器：原始研究台（单方块，右键打开）"
		"材料：纸 ×1、墨囊 ×1"
		"耗时 300 秒，产出研究笔记 ×2"
		""
		"§7拿到笔记即解锁机动科技；电力时代以前，科技只靠笔记解锁。"
	]
	quest.5A1B000000000001.title: "第一份笔记"
	quest.5A1B000000000002.quest_desc: [
		"机器：机械研究台（3×3×3，吃旋转应力）"
		"材料：空白蓝图 ×1、演算数据 ×6、黄铜板 ×4"
		"耗时 12 秒，需持续应力 16 @ 32RPM"
		"产出：蓝图·机械 ×1"
		""
		"解锁：蒸汽（钢）：era.steam 与精密构件配方一起解锁"
	]
	quest.5A1B000000000002.title: "机械蓝图"
	quest.5A1B000000000005.quest_desc: [
		"机器：机械研究台（3×3×3，吃旋转应力）"
		"材料：研究基质 ×1、纸 ×1"
		"耗时 6 秒，需持续应力 8 @ 32RPM"
		"产出：演算数据 ×2"
		""
		"§7演算数据是电力时代以前的通用货币：研究基质 + 纸就能出，不再吃研究笔记。"
	]
	quest.5A1B000000000005.title: "演算数据"
	quest.5A1B000000000006.quest_desc: [
		"机器：机械研究台（3×3×3，吃旋转应力）"
		"材料：黎明石锭 ×4、演算数据 ×4、纸 ×1"
		"耗时 30 秒，需持续应力 16 @ 32RPM"
		"产出：研究笔记·余烬 ×1"
		""
		"解锁：余烬科技 era.ember"
	]
	quest.5A1B000000000006.title: "余烬笔记"
	quest.5A1B000000000008.quest_desc: [
		"机器：溯洄研究站（3×3×3，接入研究网络）"
		"材料：电子管 ×8、晶圆 ×4、演算数据 ×8"
		"能量：6000 FE"
		"算力：3（网络里的计算机提供）"
		"耗时：45 秒（有算力加速）"
		"产出：演算数据 ×12"
		""
		"§7跑通一次即可；这条产线可以反复跑，是电力时代的研究数据来源。"
		"研究站的两格演算数据：绕组与线圈、电网调度。它们决定后面机台的能量等级，做到发电机就能先放一放。"
	]
	quest.5A1B000000000008.title: "绕组与线圈"
	quest.5A1B000000000009.quest_desc: [
		"机器：溯洄研究站（3×3×3，接入研究网络）"
		"材料：钢板 ×8、精密构件 ×2、演算数据 ×12"
		"能量：12000 FE"
		"算力：4（网络里的计算机提供）"
		"耗时：60 秒（有算力加速）"
		"产出：演算数据 ×16"
		""
		"§7算力 4 需要 1 台精英计算机（或三台基础计算机）。"
	]
	quest.5A1B000000000009.title: "电网调度"
	quest.5A1B000000000010.quest_desc: [
		"IU 的高炉：一整个 3×3×3 的高炉块实心块（22 个高炉块），其中五格换成控制器、输入、流体输入、输出、加热泵——控制器在正前壁最下一格，铁锭从顶面正中进，水从后壁最下一格进，产物走左壁最下一格，右壁最下一格留给加热泵。"
		"拿锻造锤右键控制器组装。开工要三个条件：加热泵满热（1000）、炉里有蒸汽、料槽里有铁锭；蒸汽可以加压提产，压得越高越费蒸汽。"
		"热只有液体加热器给得出来：贴着加热泵外墙放一台，烧岩浆（汽油更快）把温度顶满。水先进流体输入仓，炉内 5 mB 水换 2 mB 蒸汽。"
	]
	quest.5A1B000000000010.quest_subtitle: "3×3×3，把炉温顶到钢的熔点"
	quest.5A1B000000000010.title: "高炉（多方块）"
	quest.5A1B00000000A101.quest_desc: [
		"曝光之前先在晶圆上甩一层光刻胶：1 塑料 + 1 红石粉 → 2 光刻胶（现实里是酚醛树脂加重氮萘醌感光剂）。"
		"显影用氢氧化钠溶液（IU 的 iufluidsodiumhydroxide），每片 250 mB；双重曝光的两道工序各吃一份胶与一份显影液。"
		"所以光刻机结构里多了一个蒸汽级流体输入仓，接的就是显影液。"
	]
	quest.5A1B00000000A101.quest_subtitle: "涂胶与显影"
	quest.5A1B00000000A101.title: "光刻胶"
	quest.5A1B00000000A102.quest_desc: [
		"汞灯 g 线 436 nm、NA 0.28：单次曝光的极限约 700 nm，这台只接 M1 1.5µm 与 M2 800nm 两片掩模。"
		"结构 3×3×3：北墙中层放能量仓、同层中格进料，上一层的北墙进显影液，南面中层出料；物品总线与流体仓都锁蒸汽级。"
		"投影物镜要用能透 436 nm 的紫外玻璃或熔石英，装进机器不消耗。"
	]
	quest.5A1B00000000A102.quest_subtitle: "436 nm，从 1.5 µm 起步"
	quest.5A1B00000000A102.title: "g 线光刻机 Mk.I"
	quest.5A1B00000000A103.quest_desc: [
		"汞灯 i 线 365 nm、NA 0.55，单次到 300 nm 级，可以印 M3 350nm。"
		"旧机台不必丢：同一节点在更短波长的机台上 k1 更小，良率更高、节拍也更快（Mk.II 40 秒一片，Mk.III 只要 20 秒）。"
		"这台站在外星科技之后：壳子是电力机壳，料是 9N 片，掩模只印到 M3 350nm。"
	]
	quest.5A1B00000000A103.quest_subtitle: "365 nm，再细一档"
	quest.5A1B00000000A103.title: "i 线光刻机 Mk.II"
	quest.5A1B00000000A104.quest_desc: [
		"KrF 准分子激光 248 nm、NA 0.70，单次 160 nm 级，印 M4 180nm；再细就不是它的活了。"
		"物镜必须能透 248 nm：熔石英或氟化钙都可以，紫外玻璃到这里就吸光了。"
		"壳子还是电力机壳，料换成 11N 片：M4 180nm 起，KrF 才跟得上。"
	]
	quest.5A1B00000000A104.quest_subtitle: "248 nm 深紫外"
	quest.5A1B00000000A104.title: "KrF 光刻机 Mk.III"
	quest.5A1B00000000A105.quest_desc: [
		"ArF 193 nm、末端水浸、NA 1.35：单次 64 nm 级，印 M5 90nm。"
		"M6 28nm 靠双重曝光（自对准双重成像）：同一片晶圆走两遍，吃两份光刻胶与显影液，时间翻倍，良率再掉约 10 个百分点。"
		"7 nm 以下要 EUV 机台，本包暂无——所以掩模到 28 nm 封顶。"
		"最后一台：12N 器件级片 + 浸没镜组，M5 90nm 与 M6 28nm 都在它身上；再细就要 EUV，本包封顶到这里。"
	]
	quest.5A1B00000000A105.quest_subtitle: "193 nm，浸没式"
	quest.5A1B00000000A105.title: "ArF 浸没光刻机 Mk.IV"
	quest.5A1B00000000A106.quest_desc: [
		"O1 紫外玻璃只到 436 nm（g 线）；O2 熔石英到 240 nm（i 线、KrF）；O3 氟化钙到 150 nm；O4 浸没镜组只配 ArF。"
		"物镜是装机配件，放进机器不消耗；换波长才换镜组。掩模按 0.1% 磨损，用完补一片。"
	]
	quest.5A1B00000000A106.quest_subtitle: "能透哪段波长，就配哪台机"
	quest.5A1B00000000A106.title: "投影物镜"
	quest.5A1B00000000A107.quest_desc: [
		"曝光晶圆进切割机，配一张测试规格单（i3/i5/i7/i9）切出分级裸片：晶圆纯度越高、规格越松，出的片越多。"
		"切割机与四台光刻机同一套结构，只差控制器与外观。"
	]
	quest.5A1B00000000A107.quest_subtitle: "曝光之后才有裸片"
	quest.5A1B00000000A107.title: "晶圆切割与分档"
	quest.5A1B00000000B201.quest_desc: [
		"把磨、洗、选三段装进一台机器：3×3×4 的架子，中间一个磨机槽、一个选别槽，接上能量仓就转。基础档并行 2，改良档并行 4。"
		"配方池分七个页签，磨矿、洗选、浮选、磁选、重选各自成页，二十九种矿一种不落。矿从正面物品仓进，尾矿浆从流体口抽走——别把它倒回槽里，一格都不剩。"
		"选矿线从这台起：磨、洗、选三段并进一台，往后接电解池与阴极铜；阴极泥里的东西留给「科技先锋」那一章。"
	]
	quest.5A1B00000000B201.quest_subtitle: "R3 · 3.0 锭/矿"
	quest.5A1B00000000B201.title: "通用选矿机"
	quest.5A1B00000000B202.quest_desc: [
		"选别才是真正分家的那一步：净碎矿两进三出，一份矿石变三份粉。硫化矿走浮选，要黄药捕收、气泡把矿粒托上来；氧化矿走磁选，不要介质；难熔矿走重选，靠比重差。"
		"现实里的选矿厂就是按矿相换药剂与设备，所以门槛写在药剂上而不是机器上：黄药在釜里几秒钟出一批，没它就开不了浮选池，多装内件也补不回来。"
	]
	quest.5A1B00000000B202.quest_subtitle: "R3 · 代价：黄药 + 2 bar 充气"
	quest.5A1B00000000B202.title: "选别：一族一套药剂"
	quest.5A1B00000000B203.quest_desc: [
		"粉进釜浸出得到硫酸盐液，再送进这台池子里通直流，金属就长在阴极上。浸出不单独设一格：粉加硫酸在釜里走一遍就够，通氧还能快一截。"
		"池子里不摆内件槽：底层铺阴极方块、顶层铺阳极方块、两室之间铺隔膜，蓄液罐里灌电解液，效率按材料算。裸池 4,950 FE/锭，换满电极与隔膜 2,300 FE/锭——这就是这一章的正反馈。"
		"外壳三档：铜壳是核电工艺原版，不锈钢壳速度 ×1.12，钛壳 ×1.28。整圈换成同一档才算升级，混着铺按铜壳算。控制器与端口用钢、青铜、不锈钢，不碰核电的机架与合金，所以它在电力时代就能开工。"
	]
	quest.5A1B00000000B203.quest_subtitle: "R5 · 4.4 锭/矿"
	quest.5A1B00000000B203.title: "电解池：接上直流"
	quest.5A1B00000000B204.quest_desc: [
		"第一批阴极铜下来的时候，槽底还留着一层黑泥：阳极里不溶的东西全缩在这里，金、银、硒、铂族一样不落。铜线的利润有一半在这层泥上。"
		"别急着扔。阳极泥是铂族与硒的唯一进料，科技先锋那一章的「阳极泥与精炼」会把它捡起来。"
	]
	quest.5A1B00000000B204.quest_subtitle: "R5 · 副产阳极泥"
	quest.5A1B00000000B204.title: "首块阴极铜"
	quest.5A1B00000000B301.quest_desc: [
		"铝土矿先用烧碱在釜里溶出，得到偏铝酸钠液；降温加晶种，氢氧化铝析出来；再焙烧，剩下的就是氧化铝。三步走完还没有铝，只是有了能电解的料。"
		"这条支线挂在晶圆线后面不是随手放的：熔盐槽的大电流整流从硒开始，硅整流器才是它的开工前置。"
	]
	quest.5A1B00000000B301.quest_subtitle: "铝的入口 · 需要硅整流"
	quest.5A1B00000000B301.title: "氧化铝：拜耳法三段"
	quest.5A1B00000000B302.quest_desc: [
		"氧化铝溶在冰晶石里，九百多度，通上几十万安培的直流，铝就积在阴极上。这是霍尔-埃鲁法，一百多年了还是最便宜的那条路。"
		"这一步不进核电工艺的电解池：那台的蓄液罐只认流体电解液，装不了熔盐料，所以熔盐电解留在本包的熔盐槽。"
		"槽体内衬与阳极都得换：石墨阳极会被氟化，内衬要挡住冰晶石。两件装上，这台槽才不是一次性的。"
	]
	quest.5A1B00000000B302.quest_subtitle: "4.2 V × 200 kA"
	quest.5A1B00000000B302.title: "熔盐电解槽"
	quest.5A1B00000000B303.quest_desc: [
		"第一块铝锭的意义不在铝，在电：一块锭背后是两万五千 FE，整章电力时代都在为这种以电换金属的交易铺路。母线、机壳、电缆从此不必抢铜。"
		"铬、钙、锶、钡这些铝热法的原料也一并有了着落——它们全要拿铝去换。"
	]
	quest.5A1B00000000B303.quest_subtitle: "25,200 FE/锭"
	quest.5A1B00000000B303.title: "电解铝"
	quest.5A1B00000000B304.quest_desc: [
		"氯化镁在熔盐里电解，阴极出镁，阳极出氯。氯不能排，接回盐酸吸收塔就是三氯氢硅与四氯化钛的料，钛线要用它。"
		"镁在这个包里有两条路：电解的纯度到 4N、电费高；皮江法（硅热）省下三倍电、产率低一截。想省钱就烧硅铁，想要纯的就上槽。"
	]
	quest.5A1B00000000B304.quest_subtitle: "6 V 槽 · 副产氯"
	quest.5A1B00000000B304.title: "镁与氯的闭环"
	quest.5A7A4F5ED830FF4C.quest_desc: ["你可能需要很多，但并不用现在制作很多。"]
	quest.5A7A4F5ED830FF4C.quest_subtitle: "不是石头"
	quest.5A958F86CC00F8C4.quest_desc: ["它浑身散发着一股寒意，来自下界灵魂沙峡谷的灵阶怪的核心。"]
	quest.5B3A49A203BC09F7.quest_desc: [
		"我们在末地发现了残留的me网络和几种神秘的合金，以我们的知识目前无法理解他们"
		"我们应该使用吗？"
	]
	quest.5B3A49A203BC09F7.quest_subtitle: "神秘的科技"
	quest.5B3A49A203BC09F7.title: "外星科技？"
	quest.5BAF4E49B483B668.quest_desc: ["三个 4k 元件：16k。到这一档，一个元件就是一整面墙的箱子。"]
	quest.5BAF4E49B483B668.quest_subtitle: "存储元件 16k"
	quest.5BAF4E49B483B668.title: "三份 4k"
	quest.5BC3C00F49EEC9AD.quest_desc: ["可以在部分裸露的石英矿石发现这种奇特的结晶。"]
	quest.5C5178DC16C37A0C.quest_desc: [
		"做一个压印器！钢锭夹着粘性活塞，中间塞福鲁伊克斯水晶与充能赛特斯石英。"
		"三样东西压在它下面：硅印刷片、印刷电路、名字印刷片。硅印刷片要晶圆，晶圆线在「电力时代」那一章。"
	]
	quest.5C5178DC16C37A0C.quest_subtitle: "压印器"
	quest.5C5178DC16C37A0C.title: "把电路压出来"
	quest.5C741FDE56BF03F6.quest_desc: ["贴着原木就能抽出乳胶。它和乳胶处理单元是一对，缺一个橡胶线就不转。"]
	quest.5C741FDE56BF03F6.quest_subtitle: "从原木里挤汁"
	quest.5C741FDE56BF03F6.title: "流体提取机"
	quest.5E0A0000000000C1.quest_desc: [
		"铂族在矿石里是硫化物固溶体，品位低到没法单独开矿：它们的工业来源一直是镍铜硫化矿的浸出渣与阳极泥。"
		"所以这条线不从铂矿开始，从九份镍精矿开始。普通镍走 IU 既有链路完全够用，只有要铂族时才值得把一整叠精矿送上湿法线。"
		"整条线占用已有的六档化学反应釜（浸出与腐蚀页签）、通用反应器与 IU 电炉，不加机器、不加结构。"
		"铂族还有第二条进料：电解精炼的阳极泥。「阳极泥与精炼」支线就挂在这一格下面。"
	]
	quest.5E0A0000000000C1.quest_subtitle: "镍线里的伴生"
	quest.5E0A0000000000C1.title: "铂从哪来"
	quest.5E0A0000000000C2.quest_desc: [
		"海绵铂进 IU 电炉熔铸成铂锭，能耗按熔点抬到 16000。铂铼重整催化剂、芯片线的贵金属件、核电电极都要铂。"
		"铂族不从别的矿里挖，只从镍精矿里带；铂矿与粗铂的直烧已经封了，铂锭只能从湿法线来。"
		"做出来之后先想清楚哪条线先推，别把第一批铂锭塞进随手的配方。"
	]
	quest.5E0A0000000000C2.quest_subtitle: "湿法线才有铂锭"
	quest.5E0A0000000000C2.title: "第一块铂"
	quest.5E0A0000000000C3.quest_desc: [
		"海绵钯熔铸成钯锭，能耗 14000。钯偏电子与催化：芯片线的触点、石油线的加氢催化剂。"
		"它和铂同批出来，但走的不是同一条路：铂靠氯化铵沉，钯靠氯气氧化后再沉。"
		"同一批浸出渣里还剩铱和锇：氧化蒸馏出四氧化锇，铱渣氯压浸出。四种金属分完，中期的贵金属账才算得清。"
	]
	quest.5E0A0000000000C3.quest_subtitle: "沉铂之后才是钯"
	quest.5E0A0000000000C3.title: "钯：同一炉里的伴生"
	quest.5E0B0000000000C4.quest_desc: [
		"130~150 ℃、0.5 MPa 氧压下用硫酸浸出：镍进硫酸镍液，铂族因为电位高、硫化物难破，全部留在渣里。"
		"釜上要桨式搅棒、钛衬里和 5 bar 气压，三个门槛缺一停。出来的铂族精矿才是真正的贵金属料。"
		"硫酸镍液加氢还原回镍粉、酸回浸出段——镍没有浪费，只是计价方式变了：九份精矿只拿回两块镍。"
	]
	quest.5E0B0000000000C4.quest_subtitle: "镍和铂族在这里分家"
	quest.5E0B0000000000C4.title: "加压氧浸"
	quest.5E0B0000000000C5.quest_desc: [
		"王水（盐酸 : 硝酸 = 3 : 1）在 90 ℃ 把铂钯溶成氯合酸，铱、锇、钌基本不溶，留在渣里。"
		"这一步是整条线的分岔口：溶液走铂钯，渣走铱锇。王水不咬硅酸盐玻璃，所以衬里是搪玻璃而不是钛——钛在盐酸里是活泼的。"
		"王水现配现用，放久了失效；釜里有单独的配制配方。"
	]
	quest.5E0B0000000000C5.quest_subtitle: "90 ℃，搪玻璃衬里"
	quest.5E0B0000000000C5.title: "王水溶解"
	quest.5E0B0000000000C6.quest_desc: [
		"王水带进来的硝酸会把氯化铵氧化掉，必须先加盐酸反复蒸干赶尽硝酸，再趁热加氯化铵：铂以柠檬黄色的氯铂酸铵析出，钯留在母液里。"
		"热的浓氯化物溶液对不锈钢是应力腐蚀，这一段要钛衬里。"
		"氯铂酸铵一出来，铂钯就已经分家：晶体走铂，母液走钯。"
	]
	quest.5E0B0000000000C6.quest_subtitle: "氯化铵把铂拉出来"
	quest.5E0B0000000000C6.title: "赶硝 + 沉铂"
	quest.5E0B0000000000C7.quest_desc: [
		"氯铂酸铵在 900 ℃ 分解成海绵铂，副产氯化铵与氯气，两者都能回用：氯化铵回沉铂段，氯气回沉钯与氯压浸出段。"
		"本包没有独立的热处理炉，煅烧在釜里做，温度用能耗表达。"
		"海绵铂还不能直接用，下一步熔铸才是锭。"
	]
	quest.5E0B0000000000C7.quest_subtitle: "900 ℃ 分解"
	quest.5E0B0000000000C7.title: "煅烧海绵铂"
	quest.5E0B0000000000C8.quest_desc: [
		"母液里是 Pd(II)，直接加氯化铵只能得到可溶的二氯二氨钯；必须先通氯氧化到 Pd(IV)，再加氯化铵才沉得下氯钯酸铵。"
		"这一步同样要钛衬里：氯气 + 盐酸 + 热溶液。"
		"沉钯放出的盐酸回前面几段，氯气则是煅烧段白送的。"
	]
	quest.5E0B0000000000C8.quest_subtitle: "Pd(II) 要先氧化成 Pd(IV)"
	quest.5E0B0000000000C8.title: "通氯沉钯"
	quest.5E0B0000000000C9.quest_desc: [
		"氯钯酸铵加水合肼还原成海绵钯，副产氯化铵与盐酸，氮气排空。"
		"氢气加稀盐酸的环境里，不锈钢是这一段的正解：搪玻璃怕热震、钛怕氢脆。"
		"海绵钯和海绵铂一样，要熔铸才成锭。"
	]
	quest.5E0B0000000000C9.quest_subtitle: "室温就能还原干净"
	quest.5E0B0000000000C9.title: "肼还原"
	quest.5E0B0000000000CA.quest_desc: [
		"铱锇渣通氧焙烧，锇被氧化成挥发性的四氧化锇随气流带走，铱留在渣里。现实中这一步在玻璃蒸馏器里做，所以衬里是搪玻璃。"
		"锇在精矿里的品位比铂钯低一个数量级，四份铱锇渣凑一批。"
		"四氧化锇剧毒且极易挥发，后面必须用浓盐酸吸收，不能直接排空。"
	]
	quest.5E0B0000000000CA.quest_subtitle: "OsO₄ 挥发性极强"
	quest.5E0B0000000000CA.title: "氧化蒸馏锇"
	quest.5E0B0000000000CB.quest_desc: [
		"四氧化锇用浓盐酸吸收成氯锇酸，再加氯化铵沉成氯锇酸铵。"
		"吸收段会放出氯气，回氯化段或氯化铵合成。"
		"沉锇和沉铂是同一套铵盐化学，只是元素换了。"
	]
	quest.5E0B0000000000CB.quest_subtitle: "盐酸吸收 → 氯化铵"
	quest.5E0B0000000000CB.title: "沉锇"
	quest.5E0B0000000000CC.quest_desc: [
		"氯锇酸铵加氢还原成锇粉，副产氯化铵与盐酸。锇的熔点 3033 ℃，熔铸能耗是全包最高的一档。"
		"锇铱是克级金属：只进精密触点与仪表支点，不要拿去做结构件。"
		"一批九份镍精矿最终只出 0.25 锇，凑批比按概率出料好核对。"
	]
	quest.5E0B0000000000CC.quest_subtitle: "700 ℃ 出锇粉"
	quest.5E0B0000000000CC.title: "氢还原锇"
	quest.5E0B0000000000CD.quest_desc: [
		"铱渣要在 10 bar 氯压下用盐酸慢慢啃，生成氯铱酸，不溶的二氧化硅作尾渣排出。"
		"钛衬里 + 涡轮搅拌 + 10 bar 气压，这一段是全章门槛最高的釜：没有钛衬里就开不了铂族线。"
		"铱在浸出渣里和锇一起富集，先蒸馏掉锇，剩下的才好浸。"
	]
	quest.5E0B0000000000CD.quest_subtitle: "铂族里最难溶的那个"
	quest.5E0B0000000000CD.title: "氯压浸铱"
	quest.5E0B0000000000CE.quest_desc: [
		"氯铱酸加氯化铵沉成氯铱酸铵。同样是钛衬里：热的浓氯化物溶液对不锈钢是应力腐蚀。"
		"铱的化学惰性最强，铵盐法是最经典也最省物料的路线。"
		"下一步氢还原出铱粉，再熔铸成铱锭。"
	]
	quest.5E0B0000000000CE.quest_subtitle: "热的浓氯化物"
	quest.5E0B0000000000CE.title: "沉铱"
	quest.5E0B0000000000CF.quest_desc: [
		"氯铱酸铵加氢还原成铱粉，副产氯化铵与盐酸；铱粉熔点 2446 ℃，熔铸能耗 20000。"
		"一批九份镍精矿最终出 1 铂 + 1 钯 + 0.25 锇 + 0.25 铱。铑和钌留在残液里不出，本包没有它们的下游，硬加就是两堆没处用的粉。"
		"到这里铂族湿法的四路都通了，剩下的就是产能与酸平衡。"
	]
	quest.5E0B0000000000CF.quest_subtitle: "最后一种金属"
	quest.5E0B0000000000CF.title: "氢还原铱"
	quest.5E0C0000000000C1.quest_desc: [
		"进料是独居石：火星上只放这一种稀土矿，因为现实里铈、镧、钕、钆、钇本来就同在一份独居石里，元素要到萃取段才拆得开。第一件事是浮选——四份独居石加脂肪酸捕收剂，浮出一份 REO 60% 的精矿。"
		"稀土不能像铜铁那样烧出来：氧化物稳定到碳还原不动它，金属只能靠氟化物钙热还原或熔盐电解。"
		"整条线在反应釜的新页签「稀土湿法」里，氧化焙烧那一条在通用反应器的流化床段。"
	]
	quest.5E0C0000000000C1.quest_subtitle: "一份混合精矿"
	quest.5E0C0000000000C1.title: "稀土从哪来"
	quest.5E0C0000000000C2.quest_desc: [
		"独居石加 50% 氢氧化钠在 150 ℃ 煮开，稀土变成氢氧化物，磷以磷酸三钠进洗水，冷却结晶回收。"
		"浓碱对搪玻璃不友好，这一段要不锈钢衬里。"
		"碱法绕开了硫酸焙烧的放氟问题，代价是烧碱——烧碱和氢氟酸是稀土账本上最大的两项。"
	]
	quest.5E0C0000000000C2.quest_subtitle: "磷酸根进洗水"
	quest.5E0C0000000000C2.title: "浓碱分解"
	quest.5E0C0000000000C3.quest_desc: [
		"600~700 ℃ 空气焙烧，氢氧化物脱水成氧化物，同时把 Ce³⁺ 氧化成 Ce⁴⁺。"
		"这一步看着平淡，却是下一步分铈的前提：CeO₂ 在盐酸里不溶，Ce³⁺ 溶。"
		"流态化焙烧炉在通用反应器的流化床段上跑，不需要衬里，只要电。"
	]
	quest.5E0C0000000000C3.quest_subtitle: "先把铈变成四价"
	quest.5E0C0000000000C3.title: "氧化焙烧"
	quest.5E0C0000000000C4.quest_desc: [
		"控制酸量把 La/Pr/Nd/Gd/Y 溶出来，CeO₂ 与钍、脉石留在渣里——工业上叫优先溶解。"
		"铈在稀土里占一半，第一道分离就在这里，不在后面的萃取槽：早摘掉，后面的萃取才跑得动。"
		"搪玻璃衬里、桨式搅拌；富铈渣单独走硝酸 + 草酸出氧化铈。"
	]
	quest.5E0C0000000000C4.quest_subtitle: "铈不在萃取槽里分开"
	quest.5E0C0000000000C4.title: "优溶分铈"
	quest.5E0C0000000000C5.quest_desc: [
		"碱液把 pH 提到 3.5~4，铁、钍、磷酸根水解成渣，稀土留在液相。"
		"铁钍渣含钍，是放射性废渣，要封存——这是现实稀土工业最沉的负担。本包按废渣处理，没有下游。"
		"萃取的进料必须是干净的：铁会把有机相毒化，后面几段都白跑。"
	]
	quest.5E0C0000000000C5.quest_subtitle: "钍是这条线的环保成本"
	quest.5E0C0000000000C5.title: "中和除杂"
	quest.5E0C0000000000C6.quest_desc: [
		"皂化 P204 把中重稀土拉进有机相、La~Nd 留在水相；再上 P507：镧几乎不被萃取、留在萃余相，镨钕反萃出来；中重那边钆是中点，铽以前与以后分开，最后多级提钇。"
		"四段萃取都要涡轮搅拌与不锈钢衬里，皂化的碱直接写进配方（皂化率约 35%）。"
		"萃取剂自己也要合成：正磷酸 + 乙基己醇酯化出 P204，再酯化一次得 P507，乙基己醇是石油线的既有产物。"
	]
	quest.5E0C0000000000C6.quest_subtitle: "镧留在萃余相里"
	quest.5E0C0000000000C6.title: "萃取分组与镧沉淀"
	quest.5E0C0000000000C7.quest_desc: [
		"镨钕氯化液加草酸沉成草酸盐，焙烧成氧化物；滤液是盐酸，正好回优溶段——盐酸在这一段是闭路的。"
		"镨钕分离系数只有 1.5，工业上要上百级萃取才分得开，磁材行业干脆直接卖镨钕合金；所以本包的钕锭就是镨钕金属，镨作为伴生组分不单列物品。"
		"萃余相里的氯化镧液加草酸沉淀、焙烧就出氧化镧；氧化镧是抛光粉与催化剂的原料，别把它当废液倒了。"
	]
	quest.5E0C0000000000C7.quest_subtitle: "工业上镨钕不分家"
	quest.5E0C0000000000C7.title: "镨钕氧化物"
	quest.5E0C0000000000C8.quest_desc: [
		"氧化镨钕加氢氟酸氟化成氟化镨钕，再用钙粉还原：2REF₃ + 3Ca → 2RE + 3CaF₂，产物真空蒸馏除钙后熔铸成锭。"
		"现实里钕的工业路线是 NdF₃-LiF 熔盐电解；钕在本包走熔盐槽（NdF₃-LiF）；钆和钇本来就是钙热还原，这里统一走钙热。"
		"氟化段三种衬里都怕 HF，不锈钢是最不坏的那个。电炉里稀土矿与稀土块的直烧已经封了，钕锭只能从这条线来。"
	]
	quest.5E0C0000000000C8.quest_subtitle: "氧化物烧不出金属"
	quest.5E0C0000000000C8.title: "钕：氟化 + 钙热还原"
	quest.5E0C0000000000C9.quest_desc: [
		"富铈渣用硝酸加热溶解（必要时加还原剂），钍与脉石不溶，再草酸沉淀、焙烧得氧化铈。"
		"氧化铈是玻璃与晶圆抛光的标准磨料（CeO₂ 的 CMP  slurry 就是它），也是稀土改性分子筛的组分。"
		"硝酸在沉淀段放回来，回溶铈段，净耗一份。"
	]
	quest.5E0C0000000000C9.quest_subtitle: "铈的老本行"
	quest.5E0C0000000000C9.title: "氧化铈"
	quest.5E0C0000000000CA.quest_desc: [
		"钆富集液两批凑一份氧化钆：钆在独居石里的品位只有钕的几分之一，凑批比按概率出料好核对。"
		"钆进芯片线的先进制程模板（钆板），其余方向是核与磁制冷。"
		"钐铕跟着钆富集液走，本包没有它们的下游，也不单列物品。"
	]
	quest.5E0C0000000000CA.quest_subtitle: "中子吸收与磁制冷"
	quest.5E0C0000000000CA.title: "氧化钆"
	quest.5E0C0000000000CB.quest_desc: [
		"钇富集液同样两批凑一份。钇的化学性质像重稀土、丰度却像轻稀土，重稀土料多级萃取后它落在铒附近。"
		"钇进完美超导线圈（YBa₂Cu₃O₇₋δ），也进钇铝石榴石。"
		"残液里的镱镥富集物没有下游，现实里是外售品，本包按残液处理，别指望它还能分。"
	]
	quest.5E0C0000000000CB.quest_subtitle: "YBCO 里的那个 Y"
	quest.5E0C0000000000CB.title: "氧化钇"
	quest.5E0C0000000000CC.quest_desc: [
		"催化裂化催化剂的活性组分是稀土交换的 Y 型分子筛（REY）：镧铈交换后焙烧固定，换来的是水热稳定性。"
		"本包用硅铝催化剂代表母体，一步交换加焙烧就出分子筛催化剂。"
		"等石油线的催化裂化落地，它就是 G2 催化剂床的料——镧铈的下游在这里，不在别处。"
	]
	quest.5E0C0000000000CC.quest_subtitle: "镧铈最值钱的老本行"
	quest.5E0C0000000000CC.title: "稀土改性分子筛"
	quest.5E0D0000000000C1.quest_desc: [
		"镍与铜的电解精炼都会留下阳极泥：阳极上不溶的部分整片剥下来，金、银、硒与铂族全在里面，品位比任何矿山都高一个数量级。"
		"所以铂族的第二条进料不是矿，是别人家的废渣。现实里全世界的铂族有一大半就是这么来的。"
	]
	quest.5E0D0000000000C1.quest_subtitle: "R6 · 别丢掉它"
	quest.5E0D0000000000C1.title: "阳极泥：铂族的第二条进料"
	quest.5E0D0000000000C2.quest_desc: [
		"阳极泥里唯一值得单独回收的半导体元素是硒。做成整流片装进熔盐槽的整流槽，那是熔盐槽能用的第一档整流——没有它也能开工，只是电费按 1.10 走。"
		"这是四件内件里最便宜的一件，也是唯一从废渣里长出来的。"
	]
	quest.5E0D0000000000C2.quest_subtitle: "电解能耗 ×0.8"
	quest.5E0D0000000000C2.title: "硒整流器：第一次提速"
	quest.5E0D0000000000C3.quest_desc: [
		"粗铜做阳极、纯铜做阴极，再电解一次，出来的是 99.99% 的电解铜。母线、真空腔、超导线圈只认这个纯度。"
		"到这一格矿线的阶梯就见顶了：一份原矿从 1.0 锭走到 5.6 锭，靠的全是前面那些多修一段就多一成的选择。"
	]
	quest.5E0D0000000000C3.quest_subtitle: "R6 · 5.6 锭/矿"
	quest.5E0D0000000000C3.title: "电解铜 4N：阶梯顶"
	quest.5E3BB328775C3E7E.quest_desc: [
		"这是个按时代往前推的包：原始 → 根源 → 余烬 → 机动 → 蒸汽 → 气动 → 末地，星辉是另一条岔路。"
		"每一章都是「先有一台机器，再有一台机器」，跳步没有配方。每一格的正文都写清楚它吃什么料、往哪台接。"
		"看不懂某一格，就去看它依赖哪一格——答案通常在上一格里。"
		"提示：前期别囤，缺什么做什么。"
	]
	quest.5E3BB328775C3E7E.quest_subtitle: "沉沦之旅 · 开篇"
	quest.5E3BB328775C3E7E.title: "先说清楚这是个什么包"
	quest.5E50B081F63F8757.quest_desc: [
		"元件模板、钢板、铁板，外面套一圈高级 RE 电池：元件:11 就是发电机的心脏。"
		"做它之前先把旁边的电池线走通——高级 RE 电池、元件:能源、元件:增强能量，越往上能量等级越高，后面每一台电力机器都吃这一串。"
	]
	quest.5E50B081F63F8757.quest_subtitle: "发电机的心脏"
	quest.5E50B081F63F8757.title: "元件:发电机"
	quest.5F132AD862CA787E.quest_desc: ["你需要将坚固合金烧红再把它压成板，或者你在一开始就这么做"]
	quest.5F132AD862CA787E.quest_subtitle: "冲压机的力气没这么大"
	quest.5F132AD862CA787E.title: "我想你很难把它压成板"
	quest.5F8B6DA26B621200.quest_desc: ["通用机械到顶的一档线。再往上要换超导，那是另一个时代的事。"]
	quest.5F8B6DA26B621200.quest_subtitle: "终极线缆"
	quest.5F8B6DA26B621200.title: "一根过 320 kFE/t"
	quest.5FA34533C1B9802F.quest_desc: ["四块高级 RE 电池裹住线圈，中间压一枚元件模板。电动机、电力储存、能量元件都要它。"]
	quest.5FA34533C1B9802F.quest_subtitle: "你需要它"
	quest.5FA34533C1B9802F.title: "元件:能源"
	quest.5FE00000000000C1.quest_desc: [
		"碎矿泡进水里，沫子带走脉石，留下的是净碎矿。这一步不涨产量，只让后面的活变便宜：石头少一半，熔炼就少烧一半燃料。"
		"IU 只给九种金属写了洗选口（铜金银铅锡锇钽镉铀），别的矿种这台机器不认。全矿种的洗选与选别在电力时代的选矿机里，那已经是下一章的支线。"
	]
	quest.5FE00000000000C1.quest_subtitle: "R2 · 前置 · 只覆盖 9 种金属"
	quest.5FE00000000000C1.title: "洗选：把脉石洗掉"
	quest.5FFCF7EAE6D167D4.quest_desc: ["三个输入槽、并行烧炼，塑料外壳包着金齿轮。前面那条橡胶线的塑料，终于有地方用了。"]
	quest.5FFCF7EAE6D167D4.quest_subtitle: "一台炉子当三台用"
	quest.5FFCF7EAE6D167D4.title: "资源熔炉"
	quest.60E6C5DE278F8AD0.quest_desc: ["是的，你或许发现了，目前你似乎并没有能力组装出一个工作台。现在只能通过石匠工作台来制作一些现阶段必要的工具了。"]
	quest.60E6C5DE278F8AD0.quest_subtitle: "工作台，但是石匠。"
	quest.60E6C5DE278F8AD0.title: "奇怪，我的工作台呢？"
	quest.60E6DBB858AD041A.quest_desc: [
		"光滑陨石做框，福鲁伊克斯粉与水晶围着中间一块充能赛特斯石英。"
		"控制器是 ME 网络的心脏：它按方块数分配频道，也决定这张网能长多大。"
	]
	quest.60E6DBB858AD041A.quest_subtitle: "ME 控制器"
	quest.60E6DBB858AD041A.title: "网络从这里开始"
	quest.60F89FEE277681EC.quest_desc: ["通过种植一些野根，在其成熟时分启动野性涌动仪式即可催生出一株野树。"]
	quest.60F89FEE277681EC.quest_subtitle: "野性勃勃"
	quest.6258080BE6F0EEC4.quest_desc: ["一种生长于岩石之间的植物。"]
	quest.62DA5DC7C85BB882.quest_desc: ["利用你的余烬机器做出指杆用于制作安山机壳"]
	quest.62DA5DC7C85BB882.quest_subtitle: "指指点点"
	quest.63D58C0364D64551.quest_desc: ["相信我，你很快就会需要这个东西。"]
	quest.63D58C0364D64551.quest_subtitle: "精准采集？！！！"
	quest.649891A244FD0BF3.quest_desc: [
		"升级你的蒸汽电解器！"
		"这台只分解流体与气体：水出氢氧、氟化氢出氢氟、溴化氢出氢溴。金属的电积与精炼是另一台槽，在支线「选矿与电积」里。"
	]
	quest.649891A244FD0BF3.quest_subtitle: "把水拆开"
	quest.649891A244FD0BF3.title: "电解器"
	quest.649F7E26857F7824.quest_desc: [
		"ohhhh，更为强劲的余烬能量发生器，你会喜欢上的，那么我要怎么给它供水呢？"
		""
		""
		"{@pagebreak}"
		"在机器的下方放置金属方块，并在金属方块周围放满岩浆。"
	]
	quest.6598E70D2B013335.quest_desc: [
		"机器：机械研究台（3×3×3，吃旋转应力）"
		"材料：晶圆 ×4、演算数据 ×8、纸 ×1"
		"耗时 60 秒，需持续应力 32 @ 32RPM"
		"产出：研究笔记·电力 ×1"
		""
		"拿到即解锁基础电力 era.electric：通用机械与 AE2 本体同时可用。"
	]
	quest.6598E70D2B013335.quest_subtitle: "电流的第一份证词"
	quest.6598E70D2B013335.title: "研究笔记·电力"
	quest.6880526327344216.quest_subtitle: "也许你也可以组装一个镐子？"
	quest.6880526327344216.title: "燧石镐的顶端"
	quest.69073E45025D285F.quest_desc: ["逻辑处理器、石英玻璃、红石：1k 元件。存储元件、合成存储、便携元件都吃它。"]
	quest.69073E45025D285F.quest_subtitle: "存储元件 1k"
	quest.69073E45025D285F.title: "最小的那一块"
	quest.698C48B9BF81BDBF.quest_desc: ["奇怪，下界森林中居然还有这种硕大蘑菇，难道下界生物有着自己获取能量的方式吗？"]
	quest.6ABB17E689175F68.quest_desc: ["来自名为容器的怪物身上的肉，击败容器似乎会释放它蕴含的灵魂。"]
	quest.6BB00000000000C1.quest_desc: [
		"下界岩里长的是热液矿：岩浆把金属从深处带上来，在裂隙里沉成硫化物。所以下界的矿种和主世界不是一套——硫、砷、铋、铊这四种只在下面有，主世界一块都不生成。"
		"高度全在 0..64，铁镐起挖。硫是整条硫酸线的料，砷进半导体与农药线，铋做易熔合金，铊在这个包里只当功能件。"
		"往后接：这四样只是开胃，同一层的玄武岩重矿才是蒸汽段真正要吃的东西，下一格。"
	]
	quest.6BB00000000000C1.quest_subtitle: "硫 · 砷 · 铋 · 铊 · 铁镐"
	quest.6BB00000000000C1.title: "下界：火山热液"
	quest.6BB00000000000C2.quest_desc: [
		"下界还有一套「玄武岩底重矿」：磁铁矿、黄铁矿、方铅矿、镍铁矿、钛铁矿、白钨矿、石英岩、硅钙铀钍矿，各 1×8、rarity 2，摊下来 4 块/区块。贴图本来就是暗色玄武岩，放在下界比放主世界更说得过去。"
		"它们不掉碎矿，掉的是矿块本身——因为吃它们的机器就是按矿块进料的：蒸汽矿物分离器、电解槽、分离线。黄铁矿出硫、方铅矿出铅银、钛铁矿出钛。"
		"往后接：分离器在工业之始那条支线里。硫酸线一直缺的料，到这里才补上。"
	]
	quest.6BB00000000000C2.quest_subtitle: "矿块进料 · 各 4 块/区块"
	quest.6BB00000000000C2.title: "玄武岩重矿：八种复合矿"
	quest.6BB00000000000C3.quest_desc: [
		"末地石上长镍：6×8 一个矿脉、48 块/区块，是这一维度的主力矿。镍钴是超基性岩与硫化矿的组合，放在「末地石 + 陨铁」这种设定里，比让它在主世界深板岩里冒出来更像回事。"
		"高度压在 0..80。末地石只存在于这一段（y<0 是空气），写低了就是白写：宝石原先写在 −64..−16，五种一块都没生成过，扫存档才发现。"
		"往后接：镍是电力时代的第一块金属，也是阳极泥与铂族的入口。"
	]
	quest.6BB00000000000C3.quest_subtitle: "6×8 · 铁镐 · 48 块/区块"
	quest.6BB00000000000C3.title: "末地：镍"
	quest.6BB00000000000C4.quest_desc: [
		"同一个维度里还有三种合金金属：钴 5×7、铬与锰各 3×6，分别在 0..80 与 0..64。镍钴铬锰本来就是一套地质组合，所以它们挤在同一层，而不是各占一个维度。"
		"钴做硬质合金与电池正极，铬做不锈钢与镀层，锰做脱氧剂。三样都是「加一点就换一种性能」的料，用途写在配比里，不在产量里。"
		"往后接：钴镍同层，电解精炼的阳极泥会一起收走；铬锰直接进不锈钢与电池。"
	]
	quest.6BB00000000000C4.quest_subtitle: "三种合金金属 · 铁镐"
	quest.6BB00000000000C4.title: "末地：钴 · 铬 · 锰"
	quest.6BB00000000000C5.quest_desc: [
		"铂、钯、铱的原矿已经删掉：这三种金属在原矿里是硫化物固溶体，品位低到没法单独开矿，本包只让它们从镍精矿与阳极泥里出来（科技先锋那一章的湿法线）。所以这一格要的是镍原矿四块——9 份纯净碎镍矿才凑一批铂族精矿。"
		"同层还放了两种复合矿。硫镍钯铂矿（braggite）是这几种金属天然共生在一起的样子；铱锇矿（iridosmine）的用途更具体——铱锇渣 → 四氧化锇 → 锇粉，本包的锇只从这条路来，Mek 的锇矿已经关掉。两种都挂着 needs_diamond_tool：钻石镐以下挖了不掉东西。"
		"往后接：铂族有两条路，科技先锋那一章的湿法线，和电解精炼的阳极泥。"
	]
	quest.6BB00000000000C5.quest_subtitle: "钻石镐 · 镍 4 / 复合矿各 2"
	quest.6BB00000000000C5.title: "末地：镍与两种复合矿"
	quest.6BB00000000000C6.quest_desc: [
		"宝石四种——红宝石、蓝宝石、黄玉、宝石石英——各 1×3、rarity 2，全锁在 24..56。这个高度是扫存档扫出来的：原先写在负层，一块都没生成。"
		"宝石在这里只当工具与装饰料，真正的价值在铱锇矿：一格带两块回去，铂族那条湿法线就不断料。"
		"往后接：末地这一支到此为止。再往上不是维度，是行星。"
	]
	quest.6BB00000000000C6.quest_subtitle: "四宝石 · 24..56"
	quest.6BB00000000000C6.title: "末地：宝石与铱锇矿"
	quest.6BB00000000000C7.quest_desc: [
		"工具门是三道门里的第二道：35 个矿块挂着 needs_iron_tool，铁镐以下挖了不掉东西。名单是主世界的锡铅银铀镓锗、下界的全部热液矿与重矿、末地的镍钴铬锰与四宝石、月球的钛钒、冰星的锂铍。"
		"为什么按金属分而不按维度分：维度只说明「你得去一趟」，工具才说明「你带得出来」。铜镐挖铁、铁镐挖镍，一级一级往上接。"
		"往后接：还剩 15 块要钻石镐，下一格。"
	]
	quest.6BB00000000000C7.quest_subtitle: "35 个矿块 · needs_iron_tool"
	quest.6BB00000000000C7.title: "铁镐：末地层的门票"
	quest.6BB00000000000C8.quest_desc: [
		"另外 9 个矿块要钻石镐：钍、两种铂族复合矿，加上水星的钨钼钽铌、火星的铪、月球的锆。铂族与稀土的原矿已经删掉，这一档比原先少了六个。全是「挖到了也拿不出来」的那一档。"
		"这一档在 JEI 里看不见，只有真去挖才知道：方块带 requiresCorrectToolForDrops，镐子不对就是挖碎了什么都不掉。"
		"往后接：难熔金属与稀土都在这道门后面，行星那一章第一格就要它。"
	]
	quest.6BB00000000000C8.quest_subtitle: "9 个矿块 · needs_diamond_tool"
	quest.6BB00000000000C8.title: "钻石镐：另一半矿"
	quest.6BB00000000000C9.quest_desc: [
		"主世界还留着 16 份 AdLods 巨型矿床：铜铁金银煤、青金红石钻石绿宝石、锡铅银锌铝、远古残骸与下界金。它们不是矿脉 feature，是一整片巨型团块，撞上就是几百块。"
		"这些矿床的地表指示物原本引用 silentgems / surfacesamples / adfinders，三个模组都没装——于是巨矿在生成，地上却什么都没有。现在换成原版花草与植物魔法的橙神秘花，普通地表也放得住。"
		"关掉的 14 份是后期金属与宝石（镍钴铱锇钯铂铑钌铀、三宝石、紫水晶、气袋）：它们已经搬到末地与行星，不能让巨矿从主世界漏出来。往后接：看见橙郁金香与矢车菊成片，往下挖。"
	]
	quest.6BB00000000000C9.quest_subtitle: "主世界 16 份巨矿"
	quest.6BB00000000000C9.title: "地表先看草：巨矿的指示物"
	quest.6BDDB3A36AADF646.quest_desc: ["青铜锭压成板，板再压成外壳。工具链从这一步开始规整：锭 → 板 → 外壳，全在挤压原型机里完成。"]
	quest.6BDDB3A36AADF646.quest_subtitle: "青铜，第一次配比"
	quest.6BDDB3A36AADF646.title: "好用的合金"
	quest.6C12306C5CC22051.title: "蒸汽机"
	quest.6DF0542F0876BFC5.quest_desc: ["埋藏在下界的燃料，似乎与煤炭有些不同之处。"]
	quest.6E16E688AE7E429D.quest_desc: ["我喜欢这株植物，有着阳光的味道，也似棉花糖柔软的果实。"]
	quest.6E8B42AD1CFCD6E2.quest_desc: [
		"蒸汽档那台水晶充能器一次只喂一颗，换到电力档之后快得多：赛特斯石英进去，充能赛特斯石英出来。"
		"AE 的福鲁伊克斯水晶全靠它供料；不着急就先用蒸汽那台顶着，主线不从这里走。"
	]
	quest.6E8B42AD1CFCD6E2.quest_subtitle: "充能也换成电的"
	quest.6E8B42AD1CFCD6E2.title: "水晶充能器（电力）"
	quest.6EAB6F79AF50C5C4.quest_desc: ["//......来自深渊二层的怪物，在竖井之中到处捕猎，它的翼膜似乎可以做出一些滑翔伞或者是气球？"]
	quest.6EFDA02FD2F7D68C.quest_desc: ["基础立方的四倍。电解分离机、压缩机这种吃电大户靠它撑过用电高峰。"]
	quest.6EFDA02FD2F7D68C.quest_subtitle: "进阶能量立方"
	quest.6EFDA02FD2F7D68C.title: "存 8 MFE"
	quest.6F68FF804AA49632.quest_desc: [
		"做一个粉碎机！富集仓磨矿，粉碎机磨锭、磨块、磨水晶——黑曜石粉就是它磨出来的。"
		"合金的产线第一环落在它身上：没有黑曜石粉就没有强化黑曜石，后面全都走不动。"
		"它只吃锭和块，矿石留给富集仓。"
	]
	quest.6F68FF804AA49632.quest_subtitle: "第一段：黑曜石粉从这儿来"
	quest.6F68FF804AA49632.title: "锭也能磨成粉"
	quest.6FC90AA2AAA16C3F.quest_desc: [
		"铁锭丢进高炉料槽：一炉烧 3 分钟，出来就是钢锭。富碳气氛把铁里的碳调到钢的范围，热和蒸汽一起把炉温顶过钢的熔点，渣子留在炉里。"
		"一座高炉能连吃所有铁，比土高炉那套闷炉子稳定得多。熔炼炉那条捷径已经封掉了：钢只从这里出，而且在这个阶段解锁之前你拿不起它。"
	]
	quest.6FC90AA2AAA16C3F.quest_subtitle: "把炉温顶过钢的熔点"
	quest.6FC90AA2AAA16C3F.title: "高炉出钢"
	quest.703E0470E806934A.quest_desc: [
		"单晶反应釜把一块 11N 多晶硅拉成 11N 单晶硅，60 秒、256 FE/t。"
		"激光处理厂或者原型激光抛光机切出四片§a11N 晶圆§f，M4、M5 掩模吃这一档。"
	]
	quest.703E0470E806934A.quest_subtitle: "一根棒，四片"
	quest.703E0470E806934A.title: "11N 晶圆"
	quest.70C08FAB16CACA19.quest_desc: [
		"做一个通电冶炼炉！活和熔炉一样，但烧得快，还能接在管道与料斗之间自己转。"
		"富集仓出来的粉也只有它能一步烧成锭，两台摆在一起，矿石的倍增才算真跑起来。"
		"它同样不碰锇：钢制机壳、灌注合金、基础电路、便宜玻璃，第一段就该有的东西。"
	]
	quest.70C08FAB16CACA19.quest_subtitle: "第一段：富集仓的搭档"
	quest.70C08FAB16CACA19.title: "用电烧，不吃煤"
	quest.7204CF628CB6AF47.quest_desc: ["生长于瘤木上的水果"]
	quest.72F0F0A761F7BAC2.quest_desc: [
		"§a地震传感器§f立在地上右键，它只回答一个问题：这下面有没有原油，在第几层。"
		"别对着石头瞎挖。找到油脉，整条石油线才有起点。"
	]
	quest.72F0F0A761F7BAC2.quest_subtitle: "先问地质，再谈开采"
	quest.72F0F0A761F7BAC2.title: "脚底下有油吗"
	quest.73F4EE5CA018D3AE.quest_desc: [
		"这台机器将产出本模组最重要的材料，在放置之前你需要去寻找一块余烬能量浓郁的地方。"
		""
		"这台机器上方中心位置输入燃料，并通过该位置输出产物。也许你需要一个能输入输出的管道？或者是某种能够拓展的东西。"
	]
	quest.73F4EE5CA018D3AE.quest_subtitle: "煤炭钻机？"
	quest.73F4FB7D17278454.quest_desc: [
		"轧辊滚一遍，把锭压成板。它不烧蒸汽也不用转轴，一手摇就出板。"
		"挤压原型机堵了、没料了，这台就是备用产线。轧辊要用铜板包铁板围一圈——钢板得等蒸汽时代。"
	]
	quest.73F4FB7D17278454.quest_subtitle: "不用电的压板机"
	quest.73F4FB7D17278454.title: "手工轧机"
	quest.7421786593C68B0E.quest_desc: ["六张铁板箍住一块铁块，就成了挤压部件。它是挤压原型机的心脏——在你做出蒸汽挤压机之前，一切板材都从这台机器里出来。"]
	quest.7421786593C68B0E.quest_subtitle: "一块会动的铁"
	quest.7421786593C68B0E.title: "挤压部件"
	quest.74556786D4F0C297.quest_desc: ["很显然，你办到了。"]
	quest.74556786D4F0C297.quest_subtitle: "余烬晶体"
	quest.749621D809C7995E.quest_desc: ["强化合金灌 40 mB 强化黑曜石：原子合金，通用机械最贵的那一档零件，一份只有几块。"]
	quest.749621D809C7995E.quest_subtitle: "原子合金"
	quest.749621D809C7995E.title: "再灌一次黑曜石"
	quest.749AF51E60268100.quest_desc: [
		"听着，为什么不试着用单片眼镜看看要怎么使用呢？"
		"使用余烬的锤子右击发射器，再右击接收器。"
		"{@pagebreak}"
		"也许，它需要红石激活？"
	]
	quest.749AF51E60268100.quest_subtitle: "一种新奇的能量传输方式"
	quest.759CE071C62F7828.quest_desc: [
		"将你的蒸汽乳胶产线升级为电力驱动！"
		"电动加工线从这里起步：干燥、锯木、乳胶、流体提取，再往里是工业先锋那几台。通了电就不用再烧蒸汽，主线也不从这里走。"
	]
	quest.759CE071C62F7828.quest_subtitle: "蒸汽的电动版"
	quest.759CE071C62F7828.title: "电力干燥机"
	quest.765570AD06A0C483.quest_desc: [
		"压力室 1.5 bar：三份线材、两支红石火把、一块§a塑料片§f，压出三块§a空印刷电路板§f。"
		"这是电路板的白坯。装元件、做机器、写研究，全从这块板子开始。"
	]
	quest.765570AD06A0C483.quest_subtitle: "一压出三块"
	quest.765570AD06A0C483.title: "空板子"
	quest.76588A9B06D5DDC7.quest_desc: ["我能够感受到一股灵魂的气息扑面而来。"]
	quest.76E6D1E7FEE60B6C.quest_desc: ["三个 1k 元件套一层：4k。往后每一档都是三份前一级，字节翻四倍。"]
	quest.76E6D1E7FEE60B6C.quest_subtitle: "存储元件 4k"
	quest.76E6D1E7FEE60B6C.title: "三份 1k"
	quest.77020F764ED60722.quest_desc: ["像是绿色棉花糖一样，可为什么是蛙蛙呢？"]
	quest.77741AB6F2713F58.quest_desc: [
		"对着箱子shift右键可以捆绑箱子，使用掠食者的皮毛摩擦防止其遭受掠食者的捕猎。"
		""
		"//......这或许就是在深渊之中运送物资的方式吧，可那些没有掌握飞路粉的人应该如何离开呢？"
	]
	quest.77AAA4247AD5F8FF.quest_desc: ["切木板，好像没什么用？"]
	quest.77AAA4247AD5F8FF.quest_subtitle: "把树变成车间"
	quest.77AAA4247AD5F8FF.title: "锯木厂"
	quest.7830616AA30B63CD.quest_desc: ["燧石包着铁。它会被装进粉碎原型机当磨盘，没有它什么也磨不动。"]
	quest.7830616AA30B63CD.quest_subtitle: "会滚的那种"
	quest.7830616AA30B63CD.title: "粉碎球"
	quest.787BF4D3F587AFBA.quest_desc: [
		"头顶露天、白天累积 SE，满 6500 SE 吐一枚碎片。"
		"碎片是阳光化合物的原料，也是本时代唯一的 SE 储备。"
	]
	quest.787BF4D3F587AFBA.quest_subtitle: "露天攒 SE"
	quest.787BF4D3F587AFBA.title: "阳光化合物生成机"
	quest.79789218839D6E7D.quest_desc: [
		"过热蒸汽从这里变成压力。调到机器要求的那一档：高了不动，低了也不动，只有刚好才转。"
		"不需要压力的机器就把旋钮归零，能省一点蒸汽。"
	]
	quest.79789218839D6E7D.quest_subtitle: "0 到 4，别调错"
	quest.79789218839D6E7D.title: "蒸汽压力调节器"
	quest.79CF9E63494C3148.quest_desc: [
		"§a安全升级§f装进机器就是一个安全阀：压力快摸到危险值的时候，它自己放掉一部分空气。"
		"压力室、气罐、长管道都值得装一个。省下的不是空气，是回头重搭一遍的时间。"
	]
	quest.79CF9E63494C3148.quest_subtitle: "压力到顶之前先放一口"
	quest.79CF9E63494C3148.title: "给机器装个泄压阀"
	quest.7A52841255FD1EFA.quest_desc: ["很简单，也很有用"]
	quest.7A52841255FD1EFA.title: "基础传动元件"
	quest.7AB868C12997BBC7.quest_desc: [
		"一只§a熔融塑料桶§f、两块腐肉、两颗蛛眼、两份火药，压力室里 1 bar 压成一桶§a蚀刻酸§f。"
		"配方看着像巫术。别问为什么，倒进蚀刻器就行——腐蚀是真的在做。"
	]
	quest.7AB868C12997BBC7.quest_subtitle: "熔融塑料桶 + 腐肉 + 蛛眼 + 火药"
	quest.7AB868C12997BBC7.title: "酸得自己配"
	quest.7BFD015338811BC2.quest_desc: ["或许你现在可以尝试狩猎一些动物？哈哈，我是说，你需要它们的皮革。"]
	quest.7BFD015338811BC2.quest_subtitle: "一块动物身上的皮"
	quest.7C37F85FE343A710.quest_desc: [
		"阳光化合物 ×2 + 铜导线 + 橡胶 ×2 → 8 条阳光能量导管。"
		"流体分离器这类吃 SE 的机器都等这条线。"
	]
	quest.7C37F85FE343A710.quest_subtitle: "把 SE 送上电网"
	quest.7C37F85FE343A710.title: "SE 线"
	quest.7C4E0000000000C1.quest_desc: [
		"铀在主世界：−56..16、2×5、10 块/区块，铁镐起挖。Mek 与 NuclearCraft 自己的铀矿都关掉了，全世界只剩 IU 这一份，原矿统一成 mekanism:raw_uranium。"
		"为什么铀留在地表而不搬去行星：核燃料要的量小、要得早。把它放在找得到的地方，玩家才会先学会「别把它堆在床边」。"
		"往后接：钍在末地；下界还有一种两种放射体长在同一块里的矿。"
	]
	quest.7C4E0000000000C1.quest_subtitle: "2×5 · −56..16 · 铁镐"
	quest.7C4E0000000000C1.title: "铀：主世界的 10 块/区块"
	quest.7C4E0000000000C2.quest_desc: [
		"下界的玄武岩底重矿里有一块叫硅钙铀钍矿，名字就是成分表：硅、钙、铀、钍。它不掉碎矿、掉矿块，进分离器或电解槽。"
		"现实里的铀矿常与钍共生（独居石、铀钍矿都是），所以这一块同时算两种料的来源，只是含量低——要成规模的钍还得去末地。"
		"往后接：分离器把它拆开，铀钍各走各的线。"
	]
	quest.7C4E0000000000C2.quest_subtitle: "一块矿里两种放射体"
	quest.7C4E0000000000C2.title: "硅钙铀钍矿：下界的复合矿"
	quest.7C4E0000000000C3.quest_desc: [
		"钍在末地 16..56、1×4、rarity 2，摊 2 块/区块，钻石镐。原先写在 −48..16——末地石根本不在那一层，一块都没生成过，是扫存档扫出来才抬上来的。"
		"钍自己不太裂变，但吸收中子之后能变成铀-233。现实里的钍基核能就是这条路，所以钍不是燃料，是增殖材料。"
		"往后接：铀钍两种锭到手，剩下的是燃料线，不在这章。"
	]
	quest.7C4E0000000000C3.quest_subtitle: "1×4 · rarity 2 · 钻石镐"
	quest.7C4E0000000000C3.title: "钍：末地的 16..56"
	quest.7C4E0000000000C4.quest_desc: [
		"铀锭与钍锭各两块，矿物这一侧就齐了：主世界的铀、下界的复合矿、末地的钍，三条来源全通。"
		"这一章只交代料从哪来，不碰反应堆：燃料棒、慢化剂、冷却那套在后面的核章节里。"
		"往后接：把矿变成燃料之前，先想清楚废料放哪——本包的核废料不会自己消失。"
	]
	quest.7C4E0000000000C4.quest_subtitle: "铀 · 钍 · 复合矿"
	quest.7C4E0000000000C4.title: "料齐了：三条来源都通"
	quest.7C4E0000000000C5.quest_desc: [
		"IU 的提纯链从「放射性粗铀」开始：粗铀 → 光辉化 → 铀-235 / 铀-238。矿挖出来先进这一步，不是直接扔进反应堆。"
		"现实里从矿石到燃料要浸出、萃取、转化、浓缩四段，包里压成一条链，所以这一格只要两件粗铀就能过。"
		"往后接：235 与 238 分开之后，才是燃料棒与增殖。"
	]
	quest.7C4E0000000000C5.quest_subtitle: "粗铀 → 铀-235 / 238"
	quest.7C4E0000000000C5.title: "粗铀：下一步才是浓缩"
	quest.7C5D2124B8AE69A6.quest_desc: ["升级你的余烬机器！"]
	quest.7E2342ED402B6E97.quest_desc: [""]
	quest.7E2342ED402B6E97.quest_subtitle: "燃煤发电机？......！"
	quest.7F037DF5FFF945BB.quest_desc: ["来自灵魂沙峡谷随处可见的岩石。"]
	quest.7FBCB9C7839329EE.quest_desc: [
		"很简单的电池"
		"这条线一共三格，它是底料。往后元件:能源、元件:增强能量一层层往上，所有电力机器的壳子里都塞着这一串东西；主线只要求你做得出一块元件:发电机。"
	]
	quest.7FBCB9C7839329EE.quest_subtitle: "用来存电"
	quest.7FBCB9C7839329EE.title: "高级 RE 电池"
	quest.A900000000000001.quest_desc: [
		"三氯硅烷进多方块蒸馏器：BCl3 沸点低、PCl3 沸点高，一头一尾切掉，中间 850mB 才是 9N 的料。"
		"6N 片只能印到 800nm，再细就得靠这一塔把硼磷压下一个数量级。"
	]
	quest.A900000000000001.quest_subtitle: "6N 的天花板就在这一塔"
	quest.A900000000000001.title: "精馏：切掉硼和磷"
	quest.A900000000000002.quest_desc: [
		"高纯三氯硅烷进结晶器，一千一百度分解沉积在硅芯上，长成西门子多晶硅棒。"
		"温度不够只会得到粉料——所以它不进熔炉，只进结晶器。"
	]
	quest.A900000000000002.quest_subtitle: "在硅芯上长棒"
	quest.A900000000000002.title: "西门子沉积：9N 多晶硅"
	quest.A900000000000003.quest_desc: [
		"西门子棒进单晶反应釜直拉成 9N 单晶硅，再进激光处理厂切四片 9N 晶圆。"
		"拿到 9N 片，才算拿到 M3 350nm 的入场券：i 线机台只认这一档以上的晶圆。"
	]
	quest.A900000000000003.quest_subtitle: "拉出来再切"
	quest.A900000000000003.title: "9N 单晶与切片"
	quest.B100000000000001.quest_desc: [
		"三氯硅烷进通用塔器的反应精馏池，歧化成硅烷 + 四氯化硅；四氯化硅配氢回釜里再生三氯硅烷，氯不出口。"
		"硅烷沸点 −112°C，本身又是一次精馏级提纯，11N 就从这里来。"
	]
	quest.B100000000000001.quest_subtitle: "塔器里的反应精馏"
	quest.B100000000000001.title: "歧化：三氯硅烷变硅烷"
	quest.B100000000000002.quest_desc: [
		"硅烷进结晶器，八百度热分解成 11N 多晶硅。"
		"这一步把碳氧与金属再压一档：M4 的 180nm 只认 11N 以上的片。"
	]
	quest.B100000000000002.quest_subtitle: "八百度，直接分解"
	quest.B100000000000002.title: "裂解：11N 多晶硅"
	quest.B100000000000003.quest_desc: [
		"11N 多晶硅进单晶反应釜直拉，激光处理厂切四片 11N 晶圆。"
		"KrF 机台（M4 180nm）与 ArF 单次曝光（M5 90nm）都吃这一档。"
	]
	quest.B100000000000003.quest_subtitle: "M4 的料在这里"
	quest.B100000000000003.title: "11N 单晶与切片"
	quest.C200000000000001.quest_desc: [
		"2 份 11N 多晶硅 + 2000mB 液氦 + 1 根铌钛线圈进磁控直拉炉：出来器件级单晶硅棒。"
		"纯度不再涨，涨的是晶体质量——磁场压住熔体对流，氧含量与径向电阻率才够 28nm 的双重曝光。"
	]
	quest.C200000000000001.quest_subtitle: "用磁场压住对流"
	quest.C200000000000001.title: "磁控直拉：器件级晶棒"
	quest.C200000000000002.quest_desc: [
		"器件级晶棒进激光处理厂，切四片 12N 晶圆。"
		"M6 · 28nm 只有这一档能印；再往下要 EUV，本包没有。"
	]
	quest.C200000000000002.quest_subtitle: "最后一代掩模的料"
	quest.C200000000000002.title: "12N 切片：极限纯晶圆"
	quest.E2AE000000000001.quest_desc: [
		"钢板围壳、银锭做触点，和我们改过的其他 AE 机器一样，它认的是这个时代的金属。"
		"两件事：把赛特斯石英充成充能赛特斯石英（做福鲁伊克斯水晶用），以及给存储元件、无线终端补电。这条线往后接「福鲁伊克斯水晶」。"
	]
	quest.E2AE000000000001.quest_subtitle: "给它电，它给东西充电"
	quest.E2AE000000000001.title: "充能器"
	quest.E2AE000000000002.quest_desc: [
		"充能赛特斯石英、红石、下界石英，一起丢进水里，就成了末地残骸里那种会发光的晶体。"
		"ME 网络的每一段线缆、每一台机器都要它。四块只是起步——玻璃线缆和控制器是几十块算的。"
	]
	quest.E2AE000000000002.quest_subtitle: "末地残骸里发光的那种"
	quest.E2AE000000000002.title: "福鲁伊克斯水晶"
	quest.E2AE000000000003.quest_desc: [
		"钢锭围壳、银锭做触点，中间留一格压印位。硅压印模板、运算压印模板、工程压印模板塞上格，材料放中间，压出来的是处理器的一半。"
		"硅印刷片吃的是晶圆线上的晶圆，不是石英粉——那条石英炼硅的捷径在电力时代开头就被掐掉了。"
	]
	quest.E2AE000000000003.quest_subtitle: "三块模板，四种印刷品"
	quest.E2AE000000000003.title: "压印器"
	quest.E2AE000000000004.quest_desc: [
		"印刷硅片垫底，配红石压出逻辑处理器，配充能赛特斯石英压出运算处理器，配金锭压出工程处理器。"
		"三种处理器是 ME 网络的三种零件：逻辑管线路，运算管合成表，工程管机器本体。二十个不算多。"
	]
	quest.E2AE000000000004.quest_subtitle: "逻辑、运算、工程"
	quest.E2AE000000000004.title: "处理器"
	quest.E2AE000000000005.quest_desc: [
		"天石围壳、福鲁伊克斯水晶做面，正中间塞一台 IU 电动机——没有电力工业就没有 ME 网络，这条配方是我们自己写的。"
		"控制器决定网络能带多少设备。它是一块可以长大的方阵，不是单独一台：从三格开始搭，不够再加。"
	]
	quest.E2AE000000000005.quest_subtitle: "网络的心脏，要一台 IU 电动机"
	quest.E2AE000000000005.title: "ME 控制器"
	quest.E2AE000000000006.quest_desc: [
		"钢板围壳、镍锭做触点，四面都能接线。把通用线缆贴到任意一面，FE 就变成 AE——ME 网络从「存着」变成「活着」。"
		"它是两条线的合流点：一条是下面的通用机械电网，一条是 ME 网络自己的频道。断电不会丢东西，只是整张网络不动。"
	]
	quest.E2AE000000000006.quest_subtitle: "AE 与 Mek 在这里握手"
	quest.E2AE000000000006.title: "能量接收器"
	quest.E2AE000000000007.quest_desc: [
		"充能器把赛特斯石英、红石、玻璃压成 1k 存储元件；驱动器是插元件的地方，一格插一只。"
		"元件有 1k / 4k / 16k / 64k 四档，先做 1k：它便宜，也够撑到你把整条矿线接进网络。"
	]
	quest.E2AE000000000007.quest_subtitle: "先有柜子，再有抽屉"
	quest.E2AE000000000007.title: "驱动器与存储元件"
	quest.E2AE000000000008.quest_desc: [
		"玻璃板、亮度元件、成型核心和湮灭核心拼出来的一块屏幕。贴上网络，里面存的东西全看得见，点一下就取。"
		"终端只是看：往里放东西要靠导入总线，往外送要靠导出总线，两格之后就是它们。"
	]
	quest.E2AE000000000008.quest_subtitle: "网络的眼睛"
	quest.E2AE000000000008.title: "ME 终端"
	quest.E2AE000000000009.quest_desc: [
		"终端加一张合成表，就是合成终端。网络里有的材料，直接在终端里排队做，不用把东西搬出来。"
		"它做的是手搓级别的自动化：一次一炉、一件一件。真正的批量合成要样板，下一格。"
	]
	quest.E2AE000000000009.quest_subtitle: "看得见，也做得出"
	quest.E2AE000000000009.title: "合成终端"
	quest.E2AE00000000000A.quest_desc: [
		"样板编码终端把配方写成一张样板；样板塞进样板供应器，供应器把材料推给贴着它的那台机器，机器出料再送回网络。"
		"一台供应器贴一台机器，就是一条自动合成线；接口负责按需补货与收产物。一边推一边收，缺一边这条线就只走一半。"
	]
	quest.E2AE00000000000A.quest_subtitle: "把配方交给网络"
	quest.E2AE00000000000A.title: "样板与自动合成"
	quest.E2AE00000000000B.quest_desc: [
		"导入总线把箱子、机器里的东西吸进网络，导出总线按过滤把网络里的东西送出去。两只都贴在别的方块上，是网络的「手」。"
		"从这一步起，矿线、炉子、灌注机都不用人搬：导入接产出，导出接原料。ME 网络到这里算接完，往后都是扩容。"
	]
	quest.E2AE00000000000B.quest_subtitle: "网络伸手"
	quest.E2AE00000000000B.title: "导入导出总线"
	quest.E2E0000000000001.quest_desc: [
		"钢锭四块夹一格锇，中间嵌廉价玻璃——末地残骸里那只就是它。"
		"通用机械每台机器的内脏都长在这只外壳上：热力发电机、冶金灌注机、粉碎机、锇压缩机。先备两只，后面不用回头补。"
	]
	quest.E2E0000000000001.quest_subtitle: "残骸里的那只，照着重做"
	quest.E2E0000000000001.title: "钢外壳"
	quest.E2E0000000000002.quest_desc: [
		"铁板围一圈，中间一格锇，底下一只熔炉。煤、炭、岩浆，只要烧得着，FE 就从侧面出来。"
		"本包第一台不认 IU 电压的发电机：它不讲电网，只讲燃料。往后 ME 网络吃的那口电从它开始。"
	]
	quest.E2E0000000000002.quest_subtitle: "烧点东西，换点电"
	quest.E2E0000000000002.title: "热力发电机"
	quest.E2E0000000000003.quest_desc: [
		"通用线缆不分电压，插上就通；机器要多少给多少，不会因为线细就把电流掐断。"
		"两个用处：把热力发电机的电送进能量立方，以及送到 AE 的能量接收器——两条线在这一根线上握手。"
	]
	quest.E2E0000000000003.quest_subtitle: "一种线，四档粗细"
	quest.E2E0000000000003.title: "通用线缆"
	quest.E2E0000000000004.quest_desc: [
		"发电机一直转、机器一直不吃，中间那点差额得有人兜住。能量立方就干这个：侧面接线，贴机器那侧再拉一根出去。"
		"它自己不发电。没有它的电网，一台机器停机的瞬间就是一次跳闸。"
	]
	quest.E2E0000000000004.quest_subtitle: "电也得有地方过夜"
	quest.E2E0000000000004.title: "能量立方"
	quest.E2E0000000000005.quest_desc: [
		"铁板围壳，中间一格锇，两边塞熔炉，红石做触点。一种材料配一种灌注剂，按比例混进同一格，出来是新东西。"
		"它是通用机械的入口：灌注合金、富集材料、控制电路，全从它肚子里过。少这一台，后面每台机器都差一颗零件。"
	]
	quest.E2E0000000000005.quest_subtitle: "两种东西压成一种"
	quest.E2E0000000000005.title: "冶金灌注机"
	quest.E2E0000000000006.quest_desc: [
		"铁锭灌注富集红石，是灌注合金；灌注合金再按电路的样子排一遍，是基础控制电路。"
		"通用机械后面每台机器的配方里，这两样几乎都要。它们不是材料，是这一族机器的通货——先攒一批再去造机器。"
	]
	quest.E2E0000000000006.quest_subtitle: "机器的骨头和脑子"
	quest.E2E0000000000006.title: "灌注合金与电路"
	quest.E2E0000000000007.quest_desc: [
		"富集仓把矿石洗成两倍富集粉，粉碎机磨细，通电冶炼炉烧成锭，锇压缩机把锭压成块。四台摆一排，一条矿进去，两倍金属出来。"
		"四台都长在钢外壳上，也都要电。铜、铁、金、锇走这条路都划算；速度升级以后再加，基础档先把线跑通。"
	]
	quest.E2E0000000000007.quest_subtitle: "一份矿，四道工序"
	quest.E2E0000000000007.title: "矿石线四台"
	quest.E2E0000000000008.quest_desc: [
		"铁板围壳、红石做触点、两枚灌注合金夹一只电解核心。一碗水进去，一半变氢、一半变氧，各走各的罐子。"
		"氢气不是摆设：下一格那只燃气发电机只吃气体，不吃固体。"
	]
	quest.E2E0000000000008.quest_subtitle: "水进去，氢和氧出来"
	quest.E2E0000000000008.title: "电解分离机"
	quest.E2E0000000000009.quest_desc: [
		"四格锇围一圈灌注合金，中间一只电解核心，外面套钢外壳。氢气从侧面进，电从另一侧出。"
		"热力发电机烧煤、燃气发电机烧氢、能量立方兜住峰谷、通用线缆把电送到 ME 的能量接收器——通用机械这条线到这里收尾，往后是扩产，不是解锁。"
	]
	quest.E2E0000000000009.quest_subtitle: "把氢气烧成 FE"
	quest.E2E0000000000009.title: "燃气发电机"
	task.0DFBBB1E418A4DB5.title: "不要动"
	task.10982A0E4B18D039.title: "是"
	task.2BACD5804B80E9B0.title: "我们在末地发现了这些科技"
	task.31C653416C932CC3.title: "进入末地"
	task.3A6230E78077EEAC.title: "返回"
	task.70A21E1FCEB06479.title: "探索"
	task.730D9A7451CA739E.title: "深渊之井"
}
