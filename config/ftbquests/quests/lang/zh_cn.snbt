	quest.0056045684755D67.quest_desc: [
		"在基座上放置元素象征，在上方放置对应物品。将光束炮对准炼金台，并通入红石信号，光束炮会向炼金台开炮，启动炼金仪式。"
		""
		"我想你可能需要多准备几份材料。"
		""
		"{@pagebreak}"
		"炼金失败后的产物，会显示不同的光点。亮色光点代表有一个基座中上面的材料与下方的象征匹配成功且符合配方，淡色光点代表有一个基座下方的象征是配方所需，但上方的材料与它不匹配。"
		""
		"{@pagebreak}"
		"如果我是你的话，我会尽早制作一份解码石板。"
		"但如果你问我解码石板也要炼金制作怎么办，那我的回答是，只有天知道。"
	]
	quest.0056045684755D67.quest_subtitle: "这很魔法，对吧"
	quest.03232381B779A520.quest_desc: ["奇怪，下界森林中居然还有这种硕大蘑菇，难道下界生物有着自己获取能量的方式吗？"]
	quest.058676663FEB137F.quest_desc: ["制作扩展构件，你可以用它来扩展嵌套工厂的空间"]
	quest.058676663FEB137F.quest_subtitle: "空间"
	quest.05C904B7B3FB589E.quest_desc: ["我还以为你会喜欢这个。"]
	quest.05C904B7B3FB589E.quest_subtitle: "美丽的建材"
	quest.0688CF0589EE3128.quest_desc: ["你不这么认为吗？"]
	quest.0688CF0589EE3128.quest_subtitle: "这是一种很漂亮的建材"
	quest.0706F92EF2C236B8.quest_desc: ["八张蒸汽机壳夹一颗黄铜之心，就是蒸汽机机身。本时代所有机器都长在它上面。"]
	quest.0706F92EF2C236B8.quest_subtitle: "机身、蒸汽与压力"
	quest.0706F92EF2C236B8.title: "蒸汽时代"
	quest.09200AF098A644DF.quest_desc: ["现在，来制作你的第一块合金吧。"]
	quest.09200AF098A644DF.quest_subtitle: "一种新奇的合金炉"
	quest.0932DD0AA54FD551.quest_subtitle: "或许你要自己组装？"
	quest.0932DD0AA54FD551.title: "做一把斧头有哪些步骤"
	quest.0B73D9E1303C41BD.quest_desc: ["如果我是你的话，我会尽快制作这台机器并完成它的自动化。"]
	quest.0B73D9E1303C41BD.quest_subtitle: "好像是没有什么用的机器"
	quest.0C743B1D27F300AB.quest_desc: ["多么奇怪的植物，明明从腐烂之物中生长出来的植物，却有如月光般的色彩。"]
	quest.0E2A114F298F8ACD.quest_desc: [
		"将海蓝宝石放入聚星缸，它会产出星能液，收集你的星能液，在后面会消耗很多"
		"你还可以用共振宝石，水晶石/共鸣水晶石，天辉水晶石/共鸣天辉水晶石来获取星能液"
	]
	quest.0E2A114F298F8ACD.quest_subtitle: "收集星能"
	quest.0F63E5FD6083EF59.title: "不要动"
	quest.0FEC076007556020.quest_desc: ["输入普通蒸汽，输出过热蒸汽。压力调节器只吃过热蒸汽，所以它是整条压力线的上游。"]
	quest.0FEC076007556020.quest_subtitle: "把蒸汽烧得更烫"
	quest.0FEC076007556020.title: "蒸汽流体加热器"
	quest.1057DBBF8DC8C7C0.quest_desc: [
		"我们认为一个原始人能够徒手砍伐树木过于超模了，于是对steve的双手进行了一定的限制，现在你无法通过双手来砍伐树木了。"
		""
		""
		"如果你现在试图对着一棵树长按左键，我会假装没看见。但树会记住的。"
	]
	quest.1057DBBF8DC8C7C0.quest_subtitle: "你连树都撸不了"
	quest.1057DBBF8DC8C7C0.title: "开始游戏"
	quest.124E5A52D0F2A72D.quest_subtitle: "黎明石锭真的是一块好锭吗"
	quest.1408793381C97EC0.quest_desc: ["制作坚固外壳！"]
	quest.14E2E0D36E686107.quest_desc: ["打开炉顶活板门，投入满热值的装备，再投入若干灰烬晶体（灰烬晶体越多成功率越高），关闭活板门，即可开始强化。无论成功失败都会消耗所有的灰烬晶体。"]
	quest.14E2E0D36E686107.quest_subtitle: "！？强强？！"
	quest.156E0D27F03959DC.quest_desc: ["坚固的列车机壳当然不会只用于火车，自动化！"]
	quest.156E0D27F03959DC.title: "开火车！"
	quest.15C7029E66E838F0.title: "最强的熔炉"
	quest.160B66057D2A2BC2.quest_desc: ["蒸汽驱动的挤压机。板和外壳从此可以流水线生产——虽然挤压原型机还得留着，它不要蒸汽。"]
	quest.160B66057D2A2BC2.quest_subtitle: "压力之下"
	quest.160B66057D2A2BC2.title: "蒸汽挤压机"
	quest.16DD4183EE52B969.quest_desc: ["它就像手一样"]
	quest.174358FC22916BA6.quest_desc: ["散发着令人作呕的腐烂气息，我不想再接触这种东西了。"]
	quest.176BDCB97FADED40.quest_subtitle: "化为更聚焦的力量"
	quest.176BDCB97FADED40.title: "挑剔的工作台"
	quest.18F18597F7065BA1.quest_desc: ["由于精密构件用量较大，我把循环次数改为了3次并取消了副产物"]
	quest.18F18597F7065BA1.quest_subtitle: "你一定会想自动化它的"
	quest.18F18597F7065BA1.title: "这个构件很精密"
	quest.19A9BC6D92E82033.quest_desc: ["升级你的余烬机器！"]
	quest.1B096E65D913FAC5.title: "安山物流"
	quest.1BEE6719FA581EC9.quest_desc: ["你可以在河边找到海蓝宝石，多收集点"]
	quest.1BEE6719FA581EC9.quest_subtitle: "像海一样"
	quest.1CB3010EC04C69B5.quest_desc: ["星辉魔法在高版本改动很大，不过别担心，任务会详细说明的"]
	quest.1CB3010EC04C69B5.quest_subtitle: "熬夜魔法"
	quest.1CB3010EC04C69B5.title: "星辉魔法"
	quest.1F47C907397E6D9B.quest_desc: ["好大的工作台，材料也好贵"]
	quest.1F47C907397E6D9B.title: "超大工作台"
	quest.214D1C36178640C8.quest_desc: ["制作坍缩构件，你可以用它减少不需要的空间"]
	quest.2193FBA1E0B50F7E.quest_desc: ["或许是一种美味的食物？"]
	quest.2228F6297919FB7A.quest_desc: ["这或许是你的第一个机器框架，但请注意，它也可以用作为拓展坞来使用。"]
	quest.2228F6297919FB7A.quest_subtitle: "机械核心"
	quest.22372738BD8CBD0F.quest_desc: ["原始包线机升级成蒸汽驱动，一次处理更多线，也不会再把绝缘层扯歪。"]
	quest.22372738BD8CBD0F.quest_subtitle: "线，还是那根线"
	quest.22372738BD8CBD0F.title: "蒸汽包线机"
	quest.223A36F78B6F517E.quest_desc: ["莫非这个世界的菌类都会生长到一立方米吗。"]
	quest.22BECA4CD5C08010.quest_desc: ["这把工具将用于旋转方块、链接余烬传输机器（发射器/接收器/中继器）、关闭管道侧面连接"]
	quest.22BECA4CD5C08010.quest_subtitle: "铁匠锤？扳手！"
	quest.24825836D1002DDD.quest_desc: ["像是黄色棉花糖一样，可为什么是蛙蛙呢？"]
	quest.25D01AF8BA18BB6D.quest_desc: ["在一次偶然的炼金过程中，你将一些失败的产物混合在了一起，组成了这种奇妙的物品。它似乎在呼唤你前往某个地方。"]
	quest.25D01AF8BA18BB6D.title: "远古之证"
	quest.261BB0E84BC72316.quest_desc: ["高版本删除了所有望远镜，你现在需要用星盘寻找星座"]
	quest.261BB0E84BC72316.title: "开始观星！"
	quest.266C2F26B743AD58.quest_desc: ["每当我靠近它的时候就仿佛会传来一阵哭声。"]
	quest.26C109209120EE25.quest_subtitle: "与星共振"
	quest.2723FD4DEFF29767.quest_desc: ["水车的应力被减半了，减慢你的转速"]
	quest.2723FD4DEFF29767.title: "水车仙人"
	quest.292AC0D0FB6D3181.title: "圆石生万物！"
	quest.2C027D8994527225.quest_desc: [
		"六节管道，铜板加青铜外壳。普通蒸汽只能走管道，不能走胶囊。"
		"相邻放置也能传压，但长距离还是老老实实铺管。"
	]
	quest.2C027D8994527225.quest_subtitle: "流体喜欢铜"
	quest.2C027D8994527225.title: "蒸汽管道"
	quest.2EC7210E5C7222BA.quest_desc: [
		"夜晚寻找太古魔像，击杀后用其掉落物合成 “远古法典” 。"
		"不管你是不是第一次游玩这个mod，我都希望你不要去查询一些过时的，不正确的攻略。"
	]
	quest.2EC7210E5C7222BA.quest_subtitle: "古代法典"
	quest.2EECA8F74F7C235B.quest_desc: ["利用你的搅拌机大量获取黄铜"]
	quest.2EECA8F74F7C235B.quest_subtitle: "真正的合金"
	quest.2EECA8F74F7C235B.title: "量产黄铜"
	quest.2F418266BAA45470.quest_desc: ["我相信你很快就会用用上的。"]
	quest.2F418266BAA45470.quest_subtitle: "单片眼镜"
	quest.2F67C84DFB5047F8.quest_desc: ["穿越异界，系统降临"]
	quest.2F67C84DFB5047F8.title: "阶段一"
	quest.306FF3E1D993000C.quest_desc: ["像是紫色棉花糖一样，可为什么不甜呢？"]
	quest.32D77C0E69A7F0F5.quest_desc: ["我喜欢这种植物，看起来很美味，有一种盎然的生意在其中。"]
	quest.33CA917A7FF636A6.quest_desc: [
		"很好，现在终于能够挖矿了。"
		""
		"可恶，难道我辛辛苦苦制作的燧石镐，连一块铁都挖不下来吗。我到底该怎么制作更强大的镐子来供我驱使。"
	]
	quest.34201481CF72171A.quest_desc: ["这是一种拙劣的合金锭，似乎只能用于某些土制方法制作的机器。"]
	quest.34201481CF72171A.quest_subtitle: "对前世记忆的仿造"
	quest.34201481CF72171A.title: "拙劣的合金"
	quest.34D552E8494DF63D.quest_desc: ["用搅拌器制作通红的坚固合金，再用水进行冷却"]
	quest.34D552E8494DF63D.quest_subtitle: "这样的合金有什么用呢"
	quest.34D552E8494DF63D.title: "坚固的合金"
	quest.35B9A0B50B6D5A7C.quest_desc: [
		"轧机把锭压成板、把板压成薄片，是蒸汽时代最后的成型设备。"
		"它必须架在强化铁砧上，所以整条线走到这里，才算是把钢用上了。"
	]
	quest.35B9A0B50B6D5A7C.quest_subtitle: "得先有一块好砧"
	quest.35B9A0B50B6D5A7C.title: "蒸汽轧机"
	quest.36A0B043CD532395.quest_subtitle: "流体喜欢铜"
	quest.38388EADB17FD482.quest_desc: ["现在你需要匍匐在地上寻找石子或者是rock？然后再去河岸搜索一些沙砾挖掘后掉落的燧石，接着将它分解为flint shard（燧石碎片）。然后与破坏树叶后掉落的木棍组合起来，你将获得一把燧石小刀。"]
	quest.38388EADB17FD482.quest_subtitle: "燧石，但不是打火机"
	quest.38388EADB17FD482.title: "物理，很神奇吧"
	quest.389FD240EFC2D9A8.quest_desc: ["用共振法杖寻找水晶石矿石，它将与法杖共振"]
	quest.389FD240EFC2D9A8.quest_subtitle: "藏于地下"
	quest.38AE7BE9A1702B16.quest_desc: ["用星盘寻找降星点，你会看到白色光柱，把工作台和4个大理石丢进去"]
	quest.38AE7BE9A1702B16.quest_subtitle: "光芒会教会它聆听"
	quest.39F17AE9D43DCF5C.quest_desc: ["哈哈哈，天不亡我，我现在就将那铁矿斩于镐下。"]
	quest.39F17AE9D43DCF5C.quest_subtitle: "似乎更强大了？"
	quest.39F9A7586935F24F.title: "获取燧石刀"
	quest.3C36940FAC6404ED.quest_desc: ["植物纤维，植物绳。看起来很简单，对吧？割草，捡纤维，搓绳子。但如果你割了十丛草只掉了两根纤维，请不要质疑概率——概率是给有工作台的人准备的，你现在没有。"]
	quest.3C36940FAC6404ED.quest_subtitle: "植物纤维，不是植物人"
	quest.3C36940FAC6404ED.title: "草：我招谁惹谁了"
	quest.3D94735C2E3745DD.quest_desc: [
		"将工具，护甲或武器放置在黎明石砧后放置一个太古动力核心并用铁匠锤或自动锤敲击可以使该物品获得热量条。你甚至可以放两个太古动力核心来获得一个有热量条的太古动力核心。（"
		""
		"{@pagebreak}"
		"智械机关是一种简单的防具的嵌入升级。穿着这个升级的防具可以提升杀死生物所获得的经验的数量。增加的经验数量随强化的等级增加而增加。"
		""
		"当恐怖徽章嵌入到你的盔甲时，某些怪物会害怕你。你将获得恐吓怪物的能力，怪物无法攻击你，除非你攻击它们。恐惧这些徽章持有人的怪物的比例会随升级的等级增加而增加。"
		""
		"烈焰屏障是一种装甲强化装置，在装备了拥有这种升级的护甲并且拥有便携式灰烬能量储备时，如果受到攻击，那么就会在玩家身上残绕烈焰保护玩家。攻击到玩家的生物会着火并造成一定伤害。伤害随升级的等级增加而增加。"
		""
		"{@pagebreak}"
		"散射枪管可用于灼热射线枪的升级配件，获得该升级的物品会得到一个等级的“衍射”的效果。可以将灼热射线枪的弹药变为4颗火球，此外每增加一级的“衍射”效果会让灼热射线枪每次发射的弹丸数量+1。"
		""
		"聚焦镜片用于灼热射线枪的强化组件，能够让灼热射线枪的射线具有穿透实体的能力，将该升级装在带有“衍射”升级的灼热射线枪时会使弹丸获得追踪的能力。"
		""
		"热炙器是一个简单的升级，可以应用于积累了热量的物品。嵌入这个升级后，所有被拥有这个升级的工具挖掘/杀死的方块/生物的掉落都会自动烧炼并产生相应的物品损耗。升级的等级越高，燃烧的伤害越高。需要携带式灰烬能量才能运作。"
		""
		"{@pagebreak}"
		"煤渣喷气机是一种装甲强化配件，可通过黎明石砧安装在护甲上。装备带有该升级的护甲会消耗少量灰烬能量使玩家进行疾跑时能向前方突进3格的距离。"
		""
		"爆破核心是造成爆炸的升级。当嵌入到工具，使用工具挖掘方块后，它将破坏附近的方块。当嵌入到武器时，会发生爆炸并伤害附近的生物。当嵌入到护甲时，当护甲受到损耗时，会发生爆炸并吹开附近的生物。所有三种效果都随着强化升级的等级的提高而增加。"
		""
		"法师法球是一种工具和武器升级，它可以使得具有这种升级的工具拥有发射灰烬能量弹丸的能力。需要便携式灰烬能量来启动。当使用（左键）这个工具时，该工具就可以发射一个灰烬能量弹丸。弹丸的发射间隔等同于工具的复原时间。弹丸的尺寸和伤害随升级的等级增加而增加。"
		"由于法师法球的强化允许工具或者武器射击由灰烬能量形成的弹丸。因此添加了法师法球强化的工具或者武器也可以接受改变弹射物性状的升级强化。"
		""
		"{@pagebreak}"
		"共鸣之铃是嵌入到工具的升级。它能通过拥有此升级的工具右键敲击某类方块，使得附近的同类方块发光。共鸣的范围随升级的等级增加而增加。"
	]
	quest.3D94735C2E3745DD.quest_subtitle: "？！强强！？"
	quest.42EBA0AD040439BF.quest_desc: ["神之手的力量是无穷的"]
	quest.42EBA0AD040439BF.title: "神之手"
	quest.469AD01E07552C3C.quest_desc: [
		"用你的动力合成器制作粉碎轮"
		"当心，不要掉下去"
	]
	quest.469AD01E07552C3C.quest_subtitle: "自从有了粉碎轮之后家里只剩粉碎轮了"
	quest.4717D5F0DFBD7A6C.quest_desc: [
		"如果你有足够的毅力和时间的话，你甚至可以手搓完机械动力章节"
		"另外，你需要用指杆制作你的第一个黄铜机壳来制作机械手"
	]
	quest.4717D5F0DFBD7A6C.title: "手搓仙人"
	quest.48BEE62B80F62549.quest_desc: ["或许，你真的可以挖一点东西了？"]
	quest.4A1B91231661F70F.quest_desc: ["你的第一个机械动力机壳"]
	quest.4A1B91231661F70F.quest_subtitle: "安山时代"
	quest.4C2722480E36EC49.quest_desc: ["机身的第一份工作：烧水。每三刻消耗 2mB 水，产出 2mB 蒸汽。"]
	quest.4C2722480E36EC49.quest_subtitle: "每三刻，两桶水"
	quest.4C2722480E36EC49.title: "蒸汽锅炉"
	quest.4D7D787C9864FCEF.quest_desc: ["奇特的菌类物质好像，它似乎还会发光，难道这是诱捕某种微小生物的方式吗？"]
	quest.4D92FDC6EA6BDD71.quest_desc: [
		"汇聚生灵之气，调转玄妙之间，聚火成堆。"
		""
		"柴堆，司炼造、调灵、转化。"
	]
	quest.4D92FDC6EA6BDD71.quest_subtitle: "柴堆？小熔炉！"
	quest.4E2996D1346A91DD.quest_desc: ["我发现粘土与沙子可以混合成一种奇妙的物质，它似乎蕴含着某种神奇的力量。或许，我可以通过柴堆把它们烤干？"]
	quest.50E6857A8D8A924B.quest_desc: ["在通过这扇门的同时，你的脑海中涌入了大量的信息。原来，这里叫作下界。"]
	quest.50E6857A8D8A924B.title: "远古回响"
	quest.50FFF3DA2CF84C7F.quest_desc: [
		"普通蒸汽在加热器里过一遍就是过热蒸汽。它不能走蒸汽管道，只能走流体管道或胶囊。"
		"手里拿一桶，再去调压力。"
	]
	quest.50FFF3DA2CF84C7F.quest_subtitle: "再烧一次"
	quest.50FFF3DA2CF84C7F.title: "过热蒸汽"
	quest.5319BE2FE47DFFE5.quest_desc: ["制作电子装配台和电子工作台，你可以用他们手搓电路板"]
	quest.5319BE2FE47DFFE5.title: "手搓电路板！"
	quest.5395E48294293E81.quest_desc: [
		"炼金台每接入一个熵演枚举器，便允许两个正确的元素象征与原材料错配，在此基础上每额外接入一个，则额外多允许一个正确的元素象征错配。"
		""
		"炼金台每接入两个熵演枚举器，便允许存在一个错误的元素象征。"
		""
		""
		"想要偷懒，就要接受最严厉的惩罚。"
	]
	quest.5395E48294293E81.quest_subtitle: "我想你可能会喜欢这个"
	quest.541A81224FDBD420.quest_desc: [
		"通过熔炼炉熔炼你的矿物吧，并将流体导出到压印基座，接着在压印基座上方空出一格放置压印锤。"
		""
		"为你的第一块金属锭而欢呼雀跃吧。"
	]
	quest.541A81224FDBD420.quest_subtitle: "熔炉？！"
	quest.54292046716034B6.quest_desc: ["我曾在森林的树荫底下发现过这些自然造物，它们似乎具有某种特别的魔力？"]
	quest.54A917D73EE764DB.title: "黄铜物流"
	quest.553DE08FF8207EFC.quest_desc: ["你终于不用站在粉碎原型机旁边。蒸汽粉碎机一次吃更多，也快得多。"]
	quest.553DE08FF8207EFC.quest_subtitle: "不用自己动手了"
	quest.553DE08FF8207EFC.title: "蒸汽粉碎机"
	quest.55F9AE8981565D51.title: "终于不要手搓变速了"
	quest.56D4CDDFAE01BAD1.quest_desc: ["来自地狱的植物。"]
	quest.585589616E4ADF3F.quest_desc: [
		"机械动力的教程很多，因此任务的描述会略简略"
		"另外，本整合包禁用了所有动态结构"
	]
	quest.585589616E4ADF3F.quest_subtitle: "简单的合金"
	quest.585589616E4ADF3F.title: "第一块合金"
	quest.586A7BE62B560256.quest_desc: ["你吃了烧心的写字楼盒饭烧心而死，穿越异世界。叮，觉醒科技登神系统。叮，现奖励新手大礼包。"]
	quest.586A7BE62B560256.quest_subtitle: "我穿越了？"
	quest.586A7BE62B560256.title: "欢迎来到水槽之旅"
	quest.59416744F8E7ABE8.quest_desc: ["将黑曜石粉碎再注入熔岩得到坚固板！你可以用于制作下一级的机壳"]
	quest.59416744F8E7ABE8.quest_subtitle: "我想它一定很硬"
	quest.59416744F8E7ABE8.title: "坚固板"
	quest.59AD9573BD5BD642.quest_desc: ["这种力量，前所未有的力量在指掌间迸发，你似乎能将万物都碾磨成碎渣。"]
	quest.59AD9573BD5BD642.quest_subtitle: "研磨一些东西"
	quest.5A1B000000000001.quest_desc: [
		"在溯洄研究站跑通第一条研究，拿到演算数据。"
		""
		"研究站需要接入研究网络（网络中心 16 格内），否则拒绝开工。"
	]
	quest.5A1B000000000001.title: "机动研究"
	quest.5A1B000000000002.quest_desc: [
		"用黄铜锭与演算数据解锁精密构件。"
		"这条完成后蒸汽时代的地基就有了。"
	]
	quest.5A1B000000000002.title: "蒸汽精度"
	quest.5A1B000000000003.quest_desc: [
		"亲自击杀末影龙，电力时代由此开启。"
		""
		"§7注意：必须玩家本人击杀，命令或环境伤害不算。"
	]
	quest.5A1B000000000003.title: "龙之证"
	quest.5A7A4F5ED830FF4C.quest_desc: ["你可能需要很多，但并不用现在制作很多。"]
	quest.5A7A4F5ED830FF4C.quest_subtitle: "不是石头"
	quest.5A958F86CC00F8C4.quest_desc: ["它浑身散发着一股寒意，来自下界灵魂沙峡谷的灵阶怪的核心。"]
	quest.5BC3C00F49EEC9AD.quest_desc: ["可以在部分裸露的石英矿石发现这种奇特的结晶。"]
	quest.5F132AD862CA787E.quest_desc: ["你需要将坚固合金烧红再把它压成板，或者你在一开始就这么做"]
	quest.5F132AD862CA787E.quest_subtitle: "冲压机的力气没这么大"
	quest.5F132AD862CA787E.title: "我想你很难把它压成板"
	quest.60E6C5DE278F8AD0.quest_desc: ["是的，你或许发现了，目前你似乎并没有能力组装出一个工作台。现在只能通过石匠工作台来制作一些现阶段必要的工具了。"]
	quest.60E6C5DE278F8AD0.quest_subtitle: "工作台，但是石匠。"
	quest.60E6C5DE278F8AD0.title: "奇怪，我的工作台呢？"
	quest.60F89FEE277681EC.quest_desc: ["通过种植一些野根，在其成熟时分启动野性涌动仪式即可催生出一株野树。"]
	quest.60F89FEE277681EC.quest_subtitle: "野性勃勃"
	quest.6258080BE6F0EEC4.quest_desc: ["一种生长于岩石之间的植物。"]
	quest.62DA5DC7C85BB882.quest_desc: ["利用你的余烬机器做出指杆用于制作安山机壳"]
	quest.62DA5DC7C85BB882.quest_subtitle: "指指点点"
	quest.6880526327344216.quest_subtitle: "也许你也可以组装一个镐子？"
	quest.6880526327344216.title: "燧石镐的顶端"
	quest.698C48B9BF81BDBF.quest_desc: ["奇怪，下界森林中居然还有这种硕大蘑菇，难道下界生物有着自己获取能量的方式吗？"]
	quest.6ABB17E689175F68.quest_desc: ["来自名为容器的怪物身上的肉，击败容器似乎会释放它蕴含的灵魂。"]
	quest.6BDDB3A36AADF646.quest_desc: ["青铜锭压成板，板再压成外壳。工具链从这一步开始规整：锭 → 板 → 外壳，全在挤压原型机里完成。"]
	quest.6BDDB3A36AADF646.quest_subtitle: "青铜，第一次配比"
	quest.6BDDB3A36AADF646.title: "好用的合金"
	quest.6C12306C5CC22051.title: "蒸汽机"
	quest.6DF0542F0876BFC5.quest_desc: ["埋藏在下界的燃料，似乎与煤炭有些不同之处。"]
	quest.6E16E688AE7E429D.quest_desc: ["我喜欢这株植物，有着阳光的味道，也似棉花糖柔软的果实。"]
	quest.73F4EE5CA018D3AE.quest_desc: [
		"这台机器将产出本模组最重要的材料，在放置之前你需要去寻找一块余烬能量浓郁的地方。"
		""
		"这台机器上方中心位置输入燃料，并通过该位置输出产物。也许你需要一个能输入输出的管道？或者是某种能够拓展的东西。"
	]
	quest.73F4EE5CA018D3AE.quest_subtitle: "煤炭钻机？"
	quest.74556786D4F0C297.quest_desc: ["很显然，你办到了。"]
	quest.74556786D4F0C297.quest_subtitle: "余烬晶体"
	quest.749AF51E60268100.quest_desc: [
		"听着，为什么不试着用单片眼镜看看要怎么使用呢？"
		"使用余烬的锤子右击发射器，再右击接收器。"
		"{@pagebreak}"
		"也许，它需要红石激活？"
	]
	quest.749AF51E60268100.quest_subtitle: "一种新奇的能量传输方式"
	quest.76588A9B06D5DDC7.quest_desc: ["我能够感受到一股灵魂的气息扑面而来。"]
	quest.77020F764ED60722.quest_desc: ["像是绿色棉花糖一样，可为什么是蛙蛙呢？"]
	quest.79789218839D6E7D.quest_desc: [
		"过热蒸汽从这里变成压力。调到机器要求的那一档：高了不动，低了也不动，只有刚好才转。"
		"不需要压力的机器就把旋钮归零，能省一点蒸汽。"
	]
	quest.79789218839D6E7D.quest_subtitle: "0 到 4，别调错"
	quest.79789218839D6E7D.title: "蒸汽压力调节器"
	quest.7A52841255FD1EFA.quest_desc: ["很简单，也很有用"]
	quest.7A52841255FD1EFA.title: "基础传动元件"
	quest.7BFD015338811BC2.quest_desc: ["或许你现在可以尝试狩猎一些动物？哈哈，我是说，你需要它们的皮革。"]
	quest.7BFD015338811BC2.quest_subtitle: "一块动物身上的皮"
	quest.7C5D2124B8AE69A6.quest_desc: ["升级你的余烬机器！"]
	quest.7E2342ED402B6E97.quest_desc: [""]
	quest.7E2342ED402B6E97.quest_subtitle: "燃煤发电机？......！"
	quest.7F037DF5FFF945BB.quest_desc: ["来自灵魂沙峡谷随处可见的岩石。"]
	quest.E1A0000000000051.quest_desc: ["六张铁板箍住一块铁块，就成了挤压部件。它是挤压原型机的心脏——在你做出蒸汽挤压机之前，一切板材都从这台机器里出来。"]
	quest.E1A0000000000051.quest_subtitle: "一块会动的铁"
	quest.E1A0000000000051.title: "挤压部件"
	quest.E1A0000000000052.quest_desc: [
		"挤压部件、铁锭外壳、木板机架。它没有界面也没有电：右键投料，等它压，右键取件。"
		"铁砧在这一版里被封掉了——锭变板不再是锤子的事，而是这台机器的事。"
	]
	quest.E1A0000000000052.quest_subtitle: "第一台不用右手帮忙的机器"
	quest.E1A0000000000052.title: "挤压原型机"
	quest.E1A0000000000053.quest_desc: ["把铁锭塞进挤压原型机，压出八块铁板。后面每一台原型机都要吃它。"]
	quest.E1A0000000000053.quest_subtitle: "八块，起步价"
	quest.E1A0000000000053.title: "铁板"
	quest.E1A0000000000054.quest_desc: ["燧石包着铁。它会被装进粉碎原型机当磨盘，没有它什么也磨不动。"]
	quest.E1A0000000000054.quest_subtitle: "会滚的那种"
	quest.E1A0000000000054.title: "粉碎球"
	quest.E1A0000000000055.quest_desc: ["铁板做壳，铜板做衬，中间一颗粉碎球。右键投料、右键取料，你站在旁边就是它的动力。"]
	quest.E1A0000000000055.quest_subtitle: "手摇的磨"
	quest.E1A0000000000055.title: "粉碎原型机"
	quest.E1A0000000000056.quest_desc: ["木板加玻璃。乳胶从这里开始变成橡胶，湿的零件也从这里变干。"]
	quest.E1A0000000000056.quest_subtitle: "晾干也是一种工艺"
	quest.E1A0000000000056.title: "干燥原型机"
	quest.E1A0000000000057.quest_desc: ["长按右键启动，胶囊负责把抽上来的液体装走。它覆盖下方 3×1×3 的范围。"]
	quest.E1A0000000000057.quest_subtitle: "液体必须待在它下方"
	quest.E1A0000000000057.title: "原型泵"
	quest.E1A0000000000058.quest_desc: [
		"两张黏土一张沙一份砂砾，先揉成坯再烧成砖。原配方要尖晶石粒和钇粒，那是电力时代的金属，忘掉它们。"
		"十六块砖只是起步，熔炼炉是多方块结构，砖永远不嫌多。"
	]
	quest.E1A0000000000058.quest_subtitle: "黏土、沙、砂砾"
	quest.E1A0000000000058.title: "熔炼砖"
	quest.E1A0000000000059.quest_desc: ["四块熔炼砖拼成一节炉体。三十来节就够围出一个小炉子。"]
	quest.E1A0000000000059.quest_subtitle: "四块砖换一层壳"
	quest.E1A0000000000059.title: "熔炼炉体"
	quest.E1A000000000005A.quest_desc: ["锡板做内衬，铅板做底座，中间垫一层木桶。熔融金属的容器不需要漂亮，只需要不漏。"]
	quest.E1A000000000005A.quest_subtitle: "锡衬里，铅底座"
	quest.E1A000000000005A.title: "熔炼炉炉缸"
	quest.E1A000000000005B.quest_desc: ["整个熔炼炉的大脑。搭好结构后右键它，炉子就算立起来了。"]
	quest.E1A000000000005B.quest_subtitle: "红石与中继器"
	quest.E1A000000000005B.title: "熔炼炉控制器"
	quest.E1A000000000005C.quest_desc: [
		"燃料箱、炉体、浇注块加上控制器，熔炼炉才算完整。往燃料箱灌熔岩，把锭、方块、矿石丢进炉子等它们化开。"
		"液体可以在炉内混合，也可以倒进浇注块配模具成型。从此你不再一块一块地烧金属。"
		"注意：钢不在它的菜单里。这个炉子只做基础金属，钢是蒸汽时代末尾的事。"
	]
	quest.E1A000000000005C.quest_subtitle: "你的第一炉水"
	quest.E1A000000000005C.title: "熔炼炉"
	quest.E1A000000000005D.quest_desc: ["八块铁板围出一个锭模。放进浇注块，再把液体倒进去，锭就回来了。"]
	quest.E1A000000000005D.quest_subtitle: "把水变回锭"
	quest.E1A000000000005D.title: "铸型模具"
	quest.E1A000000000005E.quest_desc: ["木板、原木、铁板，拉动手柄把裸线裹上绝缘层。没有它，铜线只能当装饰品。"]
	quest.E1A000000000005E.quest_subtitle: "给铜穿上衣服"
	quest.E1A000000000005E.title: "原始包线机"
	quest.E1A000000000005F.quest_desc: [
		"铜板围壳、铜机壳做胆、里面塞一台熔炉。这台铜锅炉是 IU 原始与蒸汽两代的通用件："
		"原型流体加热器、乳胶提取机、原型流式腐蚀釜、蒸汽储存器、蒸汽流体加热器、固液反应釜、锅炉储罐，里面装的都是它，别只做一个。"
	]
	quest.E1A000000000005F.quest_subtitle: "一套锅炉，到处复用"
	quest.E1A000000000005F.title: "铜锅炉"
	quest.E1A0000000000060.quest_desc: [
		"把物品浸泡在储罐里的液体中：金板做内衬，铜板做衬底，琥珀金锅炉供热。"
		"需要吸收溶液或试剂的固体毛坯都要过它一手。到这里，原始时代的手工机器就齐了——下一站是青铜。"
	]
	quest.E1A0000000000060.quest_subtitle: "把东西泡进去"
	quest.E1A0000000000060.title: "原型流式腐蚀釜"
	quest.E1B0000000000001.quest_desc: ["把板切成杆、把块切成片。切割是很多零件的最后一道工序。"]
	quest.E1B0000000000001.quest_subtitle: "一刀两断"
	quest.E1B0000000000001.title: "蒸汽切割机"
	quest.E1B0000000000002.quest_desc: ["熔融材料从模具里挤成线材和杆件。和轧机配一对，板与杆都不缺。"]
	quest.E1B0000000000002.quest_subtitle: "挤出来就是一根"
	quest.E1B0000000000002.title: "蒸汽挤出机"
	quest.E1B0000000000003.quest_desc: ["从物品里榨出液体：橡胶、树脂、植物油。副产物是它最可爱的地方。"]
	quest.E1B0000000000003.quest_subtitle: "榨干最后一点"
	quest.E1B0000000000003.title: "蒸汽提取机"
	quest.E1B0000000000004.quest_desc: ["用蒸汽和激光把零件表面磨到镜面。晶体和精密件过一遍，后面装机才不卡。"]
	quest.E1B0000000000004.quest_subtitle: "金属也需要体面"
	quest.E1B0000000000004.title: "蒸汽抛光机"
	quest.E1B0000000000005.quest_desc: ["从橡胶木里榨乳胶。乳胶干燥之后才是橡胶，橡胶是蒸汽时代一切密封件的原料。"]
	quest.E1B0000000000005.quest_subtitle: "橡胶的前半生"
	quest.E1B0000000000005.title: "蒸汽乳胶提取机"
	quest.E1B0000000000006.quest_desc: ["原型泵的成年版：通上蒸汽与水，它自己把液体送到你要去的地方。"]
	quest.E1B0000000000006.quest_subtitle: "终于不用长按右键"
	quest.E1B0000000000006.title: "蒸汽泵"
	quest.E1B0000000000007.quest_desc: ["只从安装面输入蒸汽，其余方向只输出。把它当成蒸汽电池，机器挨着它就不怕断供。"]
	quest.E1B0000000000007.quest_subtitle: "存一点压力"
	quest.E1B0000000000007.title: "蒸汽储存器"
	quest.E1B0000000000008.quest_desc: [
		"蒸汽提供热量与加压，真正的化学过程还得靠电流转换器给的电流。"
		"它可以把水拆成氢和氧，是你第一次真正接触气体工艺。"
	]
	quest.E1B0000000000008.quest_subtitle: "通了电才算完整"
	quest.E1B0000000000008.title: "蒸汽电解器"
	quest.E1B0000000000009.quest_desc: ["处理致密矿石，把有用的部分和废石分开，不需要电网。产物概率比电动的低一点，蒸汽时代够用。"]
	quest.E1B0000000000009.quest_subtitle: "把石头还回去"
	quest.E1B0000000000009.title: "蒸汽矿物分离器"
	quest.E1B000000000000A.quest_desc: [
		"外壳、控制器、储罐、加热器、热交换器：五件套围起来才是正经锅炉，每刻 1mB 水换 2mB 蒸汽，效率是小型锅炉的两倍。"
		"控制器自己开不了，必须靠热交换器：往加热器供热，往储罐注水。热交换器里要十根线圈和一个铁氧体环形电感。"
	]
	quest.E1B000000000000A.quest_subtitle: "这次是真的锅炉房"
	quest.E1B000000000000A.title: "蒸汽锅炉（多方块）"
	quest.E1B000000000000B.quest_desc: ["高压蒸汽锅炉、机器外壳、电动机拼在一起：蒸汽进去，电出来。这是蒸汽时代向电力时代递出的请柬。"]
	quest.E1B000000000000B.quest_subtitle: "蒸汽与电的第一次握手"
	quest.E1B000000000000B.title: "电动蒸汽发生器"
	quest.E1B000000000000C.quest_desc: ["接上蒸汽和钻管，它会一路向下把工作区域的方块挖出来。记得在它下面留空间，也记得回来收矿。"]
	quest.E1B000000000000C.quest_subtitle: "往地下钻"
	quest.E1B000000000000C.title: "蒸汽采石机"
	quest.E1B000000000000D.quest_desc: ["熔炼炉的袖珍版：拿熔融矿石胶囊右键它，上方出现粗金属锭，再右键取走。适合分散的小规模铸造。"]
	quest.E1B000000000000D.quest_subtitle: "一炉一小块"
	quest.E1B000000000000D.title: "微型熔炉"
	quest.E1B000000000000E.quest_desc: [
		"把铁锭和大量煤一起闷在土高炉里：碳渗进铁里，钢就出来了。很慢，很费燃料，但这是你第一次拿到比铁更硬的东西。"
		"熔炼炉那条捷径已经封掉了。钢只从这里出，而且在这个阶段解锁之前你拿不起它。"
	]
	quest.E1B000000000000E.quest_subtitle: "往铁里塞点碳"
	quest.E1B000000000000E.title: "渗碳成钢"
	quest.E1B000000000000F.quest_desc: [
		"钢要配一块钢做的砧。普通铁砧敲不动重活，强化铁砧可以。"
		"它还是蒸汽轧机的地基——没有它，轧机连立都立不起来。"
	]
	quest.E1B000000000000F.quest_subtitle: "配得上钢的砧"
	quest.E1B000000000000F.title: "强化铁砧"
	quest.E1C0000000000001.quest_desc: ["研究站里用 8 片晶圆和 16 份演算数据，把电磁感应、真空管与硅器件写成一份可复制的笔记。拿到它，电力时代才算真正开始：AE2 本体与工业先锋同时开门。"]
	quest.E1C0000000000001.quest_subtitle: "电流的第一份证词"
	quest.E1C0000000000001.title: "研究笔记·电力"
	quest.E1C0000000000002.quest_desc: ["一个元件:发电机加一块电力机壳。它吃煤、吃生物质，吐出 IU 自己的电。整个时代的机器都挂在这台机器后面。"]
	quest.E1C0000000000002.quest_subtitle: "烧煤换电"
	quest.E1C0000000000002.title: "发电机"
	quest.E1C0000000000003.quest_desc: ["四块电镀外壳压成一块机壳。电力时代的每一台机器都要它，先囤十六块再说。"]
	quest.E1C0000000000003.quest_subtitle: "机器的骨头"
	quest.E1C0000000000003.title: "电力机壳"
	quest.E1C0000000000004.quest_desc: ["蒸汽干燥机通电之后的版本。同样把湿料烘干，但不烧蒸汽，只要有电就一直转。"]
	quest.E1C0000000000004.quest_subtitle: "蒸汽的电动版"
	quest.E1C0000000000004.title: "电力干燥机"
	quest.E1C0000000000005.quest_desc: ["蒸汽乳胶提取机的电力版。工业先锋的塑料全靠这条橡胶线，早一步通电就早一步摸到它。"]
	quest.E1C0000000000005.quest_subtitle: "橡胶的电动版"
	quest.E1C0000000000005.title: "电动乳胶提取机"
	quest.E1C0000000000006.quest_desc: ["木头进去，木板和木屑出来。木材第一次不用手砍，后面的机壳、脚手架、箱子都从这里供应。"]
	quest.E1C0000000000006.quest_subtitle: "把树变成车间"
	quest.E1C0000000000006.title: "锯木厂"
	quest.E1C0000000000007.quest_desc: ["轧辊组是轧机的核心件：六块钢板围一个轧辊，才能把锭压成板。轧机一通，钢板就再也不靠铁砧了。"]
	quest.E1C0000000000007.quest_subtitle: "板还是那张板"
	quest.E1C0000000000007.title: "手工轧机"
	quest.E1C0000000000008.quest_desc: ["蒸汽电解器的电力版。水进去，氢和氧出来；氢是硅烷线的原料，氧是后面一堆化工配方的原料。"]
	quest.E1C0000000000008.quest_subtitle: "把水拆开"
	quest.E1C0000000000008.title: "电解器"
	quest.E1C0000000000009.quest_desc: ["给 3×3 区块内的机器隔空充电。电网从此不用一根一根拉线，机台摆在哪里都能吃到电。"]
	quest.E1C0000000000009.quest_subtitle: "线缆可以收起来了"
	quest.E1C0000000000009.title: "无线供能器"
	quest.E1C000000000000A.quest_desc: ["单晶硅在这里被激光切成晶圆。没有它，硅料就只是根漂亮的棒子。"]
	quest.E1C000000000000A.quest_subtitle: "切晶圆的那把刀"
	quest.E1C000000000000A.title: "激光处理厂"
	quest.E1C000000000000B.quest_desc: ["粗制硅晶体在这里再长一次，才变成能拉单晶的电子级多晶硅。物理熔炼只能做到粗料。"]
	quest.E1C000000000000B.quest_subtitle: "把粗料长成电子级"
	quest.E1C000000000000B.title: "晶体生长室"
	quest.E1C000000000000C.quest_desc: ["电子级多晶硅在生长室里直拉成单晶硅。它不是最终产品，是切片前的坯料。"]
	quest.E1C000000000000C.quest_subtitle: "一根棒子"
	quest.E1C000000000000C.title: "单晶硅"
	quest.E1C000000000000D.quest_desc: ["一根单晶硅切四片晶圆。从这一格开始，硅才真正变成器件：IU 的电路要用它，AE 的处理器也要用它。"]
	quest.E1C000000000000D.quest_subtitle: "八片薄片"
	quest.E1C000000000000D.title: "晶圆"
	quest.E1C000000000000E.quest_desc: ["钢锭做骨架、银锭走电流、活塞压制具。AE2 本体就从这台机器开始，它的硅印刷片现在吃的是你的晶圆。压印模板不在合成表里——去天空石坑里挖，或者从别的模板翻制。"]
	quest.E1C000000000000E.quest_subtitle: "AE 的第一台机器"
	quest.E1C000000000000E.title: "压印器"
	quest.E1C000000000000F.quest_desc: ["晶圆加硅压印模板，压出印刷硅片。AE 原本「石英粉烧成硅」那条捷径已经封了，硅只能从晶圆线上来。"]
	quest.E1C000000000000F.quest_subtitle: "晶圆换成芯片"
	quest.E1C000000000000F.title: "硅印刷片"
	quest.E1C0000000000010.quest_desc: ["印刷硅片、印刷逻辑电路和红石一起压成逻辑处理器。存储、终端、线缆，全挂在它身上。"]
	quest.E1C0000000000010.quest_subtitle: "AE 的通用大脑"
	quest.E1C0000000000010.title: "逻辑处理器"
	quest.E1C0000000000011.quest_desc: ["把福鲁伊克斯水晶充成带电的。这是网络里唯一不需要额外机器的循环：电进去，水晶出来。"]
	quest.E1C0000000000011.quest_subtitle: "给水晶充电"
	quest.E1C0000000000011.title: "充能器"
	quest.E1C0000000000012.quest_desc: ["AE 网络的门。IU 的电从这里进来，换成 AE 自己的能量单位。"]
	quest.E1C0000000000012.quest_subtitle: "电网接进网络"
	quest.E1C0000000000012.title: "能量接收器"
	quest.E1C0000000000013.quest_desc: ["装存储元件的柜子。一个驱动器塞十个元件，从此箱子不再是箱子。"]
	quest.E1C0000000000013.quest_subtitle: "第一个仓库"
	quest.E1C0000000000013.title: "ME 驱动器"
	quest.E1C0000000000014.quest_desc: ["把所有存储元件摊在一张列表上。第一次点开它的时候，你会明白为什么大家都在往 AE 里搬东西。"]
	quest.E1C0000000000014.quest_subtitle: "看见整个网络"
	quest.E1C0000000000014.title: "ME 终端"
	quest.E1C0000000000015.quest_desc: ["终端加工作台再加一个运算处理器。省下的不是那两步路，是每次找配方的时间。"]
	quest.E1C0000000000015.quest_subtitle: "在终端里直接合成"
	quest.E1C0000000000015.title: "合成终端"
	quest.E1C0000000000016.quest_desc: ["中心换成一台 IU 电动机：没有电力工业，就没有 ME 网络。控制器一立，网络才会有稳定的频道数。"]
	quest.E1C0000000000016.quest_subtitle: "网络的心脏"
	quest.E1C0000000000016.title: "ME 控制器"
	quest.E1C0000000000017.quest_desc: ["接口收料，样板供应器按样板把料送出去。这一对凑齐，AE 才从仓库变成工厂。"]
	quest.E1C0000000000017.quest_subtitle: "让网络自己干活"
	quest.E1C0000000000017.title: "接口与样板供应器"
	quest.E1C0000000000018.quest_desc: ["工业先锋的第一台发电机。它发不了多少电，但足够让一台机器先转起来——工业先锋的机器都吃 FE，不是 IU 的电。"]
	quest.E1C0000000000018.quest_subtitle: "聊胜于无的电"
	quest.E1C0000000000018.title: "怜悯发电机"
	quest.E1C0000000000019.quest_desc: ["八块钢板围一个红石块，再配四根原木。工业先锋的每一台机器都要先有它。"]
	quest.E1C0000000000019.quest_subtitle: "工业先锋的入场券"
	quest.E1C0000000000019.title: "简陋机器框架"
	quest.E1C000000000001A.quest_desc: ["割胶碗收来的乳胶在这里聚成干胶，烧一遍就是塑料。塑料是高级机器框架的必需品。"]
	quest.E1C000000000001A.quest_subtitle: "橡胶变塑料"
	quest.E1C000000000001A.title: "乳胶处理单元"
	quest.E1C000000000001B.quest_desc: ["贴着原木就能抽出乳胶。它和乳胶处理单元是一对，缺一个橡胶线就不转。"]
	quest.E1C000000000001B.quest_subtitle: "从原木里挤汁"
	quest.E1C000000000001B.title: "流体提取机"
	quest.E1C000000000001C.quest_desc: ["塑料、框架、齿轮、桶，泡在乳胶里溶一遍，出来就是更高级的机器框架。工业先锋的分水岭。"]
	quest.E1C000000000001C.quest_subtitle: "往液体里配东西"
	quest.E1C000000000001C.title: "溶解室"
	task.0DFBBB1E418A4DB5.title: "不要动"
	task.31C653416C932CC3.title: "进入末地"
}
